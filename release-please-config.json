{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "bump-minor-pre-major": true,
  "separate-pull-requests": false,
  "include-component-in-tag": true,
  "changelog-sections": [
    {
      "type": "feat",
      "section": "Features"
    },
    {
      "type": "fix",
      "section": "Fixes"
    },
    {
      "type": "perf",
      "section": "Performance"
    },
    {
      "type": "docs",
      "section": "Documentation"
    },
    {
      "type": "refactor",
      "section": "Refactoring"
    }
  ],
  "packages": {
    "server": {
      "release-type": "simple",
      "component": "server",
      "initial-version": "0.2.0",
      "changelog-path": "CHANGELOG.md"
    },
    "client": {
      "release-type": "ruby",
      "component": "gem",
      "version-file": "lib/masks/version.rb",
      "changelog-path": "CHANGELOG.md"
    },
    "web": {
      "release-type": "node",
      "component": "client",
      "changelog-path": "CHANGELOG.md"
    },
    "engine": {
      "release-type": "simple",
      "component": "masks-server",
      "initial-version": "0.2.0",
      "changelog-path": "CHANGELOG.md"
    },
    "go": {
      "release-type": "go",
      "component": "go",
      "tag-separator": "/",
      "initial-version": "0.1.0",
      "changelog-path": "CHANGELOG.md"
    },
    "node": {
      "release-type": "node",
      "component": "node",
      "initial-version": "0.1.0",
      "changelog-path": "CHANGELOG.md"
    },
    "python": {
      "release-type": "python",
      "component": "python",
      "package-name": "masks-client",
      "initial-version": "0.1.0",
      "changelog-path": "CHANGELOG.md",
      "extra-files": [
        {
          "type": "toml",
          "path": "uv.lock",
          "jsonpath": "$.package[?(@.name==='masks-client')].version"
        }
      ]
    }
  },
  "plugins": [
    {
      "type": "linked-versions",
      "groupName": "server",
      "components": [
        "server",
        "masks-server"
      ]
    }
  ]
}
