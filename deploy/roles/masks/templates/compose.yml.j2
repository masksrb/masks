name: masks

services:
  masks:
    image: "{{ masks_image }}:{{ masks_image_tag }}"
    restart: unless-stopped
    environment:
      POSTGRES_HOST: "{{ masks_postgres_host }}"
      POSTGRES_PORT: "{{ masks_postgres_port }}"
      POSTGRES_USER: "{{ masks_postgres_user }}"
      POSTGRES_PASSWORD: "{{ masks_postgres_password }}"
      POSTGRES_DATABASE: "{{ masks_postgres_database }}"
      MASKS_TENANTS: "{{ masks_tenants | join(',') }}"
      MASKS_PUBLIC_ORIGIN_TEMPLATE: "{{ masks_public_origin_template }}"
      MASKS_SETUP_TOKEN: "{{ masks_setup_token }}"
      SECRET_KEY_BASE: "{{ masks_secret_key_base }}"
      ENCRYPTION_PRIMARY_KEY: "{{ masks_encryption_primary_key }}"
      ENCRYPTION_DETERMINISTIC_KEY: "{{ masks_encryption_deterministic_key }}"
      ENCRYPTION_KEY_DERIVATION_SALT: "{{ masks_encryption_key_derivation_salt }}"
      RAILS_ASSUME_SSL: "true"
      RAILS_FORCE_SSL: "true"
      SOLID_QUEUE_IN_PUMA: "true"
    healthcheck:
      test: ["CMD-SHELL", "curl -fsS http://localhost/up > /dev/null"]
      interval: 10s
      timeout: 5s
      retries: 20
      start_period: 60s
    networks:
      - "{{ masks_network }}"

networks:
  {{ masks_network }}:
    external: true
