<section class="group" id="organizations">
  <h2><%= account_text("organizations.heading") %></h2>

  <div class="entries">
    <% invitations.each do |invited| %>
      <% organization = invited.organization %>

      <details class="entry entry-invited" id="organization-<%= organization.key %>" open>
        <summary>
          <span class="entry-icon"><%= account_icon(:organization) %></span>
          <span class="entry-label"><%= organization.name %></span>
          <span class="entry-state entry-state-warn"><%= account_text("organizations.waiting") %></span>
          <span class="entry-mark" aria-hidden="true"></span>
        </summary>

        <div class="entry-body">
          <%= render "masks/server/application/flashes", organization: organization %>

          <p class="aside">
            <%= account_text("organizations.asked", organization: organization.name, role: invited.role,
                                                     by: invited.invited_by&.identifier || account_text("organizations.someone")) %>
          </p>

          <p class="item-meta">
            <span title="<%= l(invited.invited_at, format: :long) %>">
              <%= account_text("organizations.invited_ago", age: time_ago_in_words(invited.invited_at)) %>
            </span>
            · <%= account_text("organizations.expires_in", age: distance_of_time_in_words_to_now(invited.expires_at)) %>
            <% if invited.invited_as.present? %>
              · <%= account_text("organizations.sent_to", address: invited.invited_as) %>
            <% end %>
          </p>

          <% if !invited.addressed_to?(current_actor) %>
            <p class="note note-warn"><%= account_text("organizations.sent_elsewhere", address: invited.invited_as) %></p>
          <% elsif invited.invited_as.present? && current_actor.email_verified_at.nil? %>
            <p class="note note-warn"><%= account_text("organizations.confirm_first_html", address: invited.invited_as) %></p>
          <% end %>

          <div class="action-row">
            <%= button_to account_text("organizations.accept", organization: organization.name),
                  account_organization_acceptance_path(organization.key), method: :post, class: "action action-sm" %>
            <%= button_to account_text("organizations.decline"),
                  account_organization_member_path(organization.key, invited.id), method: :delete,
                  class: "action action-quiet action-sm",
                  form: { data: { turbo_confirm: account_text("organizations.confirm_decline", organization: organization.name) } } %>
          </div>
        </div>
      </details>
    <% end %>

    <% memberships.each do |own| %>
      <% organization = own.organization %>
      <% members = account_roster(organization) %>
      <% owners = members.count(&:owner?) %>
      <% joined = members.count { |member| !member.pending? } %>
      <% waiting = members.count { |member| member.pending? && !member.expired? } %>
      <% alone = own.owner? && owners == 1 %>

      <details class="entry" id="organization-<%= organization.key %>" <%= "open" if flash[:organization] == organization.key %>>
        <summary>
          <span class="entry-icon"><%= account_icon(:organization) %></span>
          <span class="entry-label"><%= organization.name %></span>
          <span class="entry-state"><%= account_text("organizations.role", role: own.role) %></span>
          <span class="entry-mark" aria-hidden="true"></span>
        </summary>

        <div class="entry-body">
          <%= render "masks/server/application/flashes", organization: organization %>

          <p class="aside"><%= account_text(own.owner? ? "organizations.lede_owner" : "organizations.lede_member") %></p>

          <% if own.owner? %>
            <p class="item-meta">
              <%= account_text("organizations.people", count: joined) %>
              · <%= account_text("organizations.owners", count: owners) %>
              <% if waiting.positive? %>
                · <%= account_text("organizations.waiting_count", count: waiting) %>
              <% end %>
            </p>

            <div class="items">
              <% members.each do |member| %>
                <% person = member.actor %>
                <% yourself = person.id == own.actor_id %>
                <% label = Masks::Server::Members.label(member) || account_text("organizations.invited_by_manager") %>
                <div class="item item-member">
                  <span class="item-name">
                    <span><%= label %></span>
                    <% if yourself %>
                      <span class="tag"><%= account_text("organizations.you") %></span>
                    <% elsif member.expired? %>
                      <span class="tag tag-bad"><%= account_text("organizations.expired") %></span>
                    <% elsif member.pending? %>
                      <span class="tag"><%= account_text("organizations.invited") %></span>
                    <% end %>
                  </span>

                  <span class="item-meta">
                    <% since, at = account_member_since(member) %>
                    <span title="<%= l(at, format: :long) %>"><%= account_text(since, age: time_ago_in_words(at)) %></span>
                    <% if member.pending? && !member.expired? && member.invited_by %>
                      <%= account_text("organizations.by", by: member.invited_by.identifier) %>
                    <% end %>
                  </span>

                  <div class="item-act item-acts">
                    <%= form_with url: account_organization_member_path(organization.key, member.id), method: :patch,
                                  class: "item-acts" do |form| %>
                      <%= form.select :role, organization.role_list, { selected: member.role },
                                      class: "control control-sm", id: "role-#{organization.key}-#{member.id}",
                                      disabled: yourself && alone,
                                      data: { autosubmit: true },
                                      aria: { label: account_text("organizations.role_of", person: label) } %>
                      <button type="submit" class="action action-quiet action-sm" data-autosubmitted <%= "disabled" if yourself && alone %>>
                        <%= account_text("organizations.set_role") %>
                      </button>
                    <% end %>

                    <% if member.pending? %>
                      <%= button_to account_text("organizations.resend"),
                            account_organization_member_resend_path(organization.key, member.id), method: :post,
                            class: "action action-quiet action-sm" %>
                    <% end %>

                    <% unless yourself %>
                      <%= button_to account_text(member.pending? ? "organizations.withdraw" : "organizations.remove"),
                            account_organization_member_path(organization.key, member.id), method: :delete,
                            class: "action action-quiet action-sm",
                            form: { data: { turbo_confirm: account_text(member.pending? ? "organizations.confirm_withdraw" : "organizations.confirm_remove",
                                                              identifier: label, organization: organization.name) } } %>
                    <% end %>
                  </div>
                </div>
              <% end %>
            </div>

            <%= form_with url: account_organization_members_path(organization.key), method: :post, class: "member-add" do |form| %>
              <label class="field member-add-email">
                <span class="field-label"><%= account_text("organizations.add_email") %></span>
                <%= form.email_field :email, required: true, autocomplete: "off", class: "control", id: "add-email-#{organization.key}",
                                     placeholder: account_text("organizations.add_placeholder") %>
              </label>

              <label class="field member-add-role">
                <span class="field-label"><%= account_text("organizations.add_role") %></span>
                <%= form.select :role, organization.role_list, { selected: Masks::Server::Organization::MEMBER }, class: "control",
                                id: "add-role-#{organization.key}" %>
              </label>

              <button type="submit" class="action action-sm member-add-go"><%= account_text("organizations.add") %></button>

              <span class="field-hint member-add-hint"><%= account_text("organizations.add_hint") %></span>
            <% end %>
          <% end %>

          <div class="member-leave">
            <% if alone %>
              <p class="aside"><%= account_text("organizations.last_owner") %></p>
            <% else %>
              <%= button_to account_text("organizations.leave", organization: organization.name),
                    account_organization_member_path(organization.key, own.id), method: :delete,
                    class: "action action-quiet action-sm",
                    form: { data: { turbo_confirm: account_text("organizations.confirm_leave", organization: organization.name) } } %>
            <% end %>
          </div>
        </div>
      </details>
    <% end %>
  </div>
</section>
