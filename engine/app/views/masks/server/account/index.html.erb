<% content_for :title, Masks::Server::Current.tenant&.name %>

<% content_for :surface, "place" %>

<% content_for :scripts do %>
  <%= vite_javascript_tag "account" %>
<% end %>

<div id="account" class="place">
  <%= render "masks/server/account/head", actor: @actor %>

  <%= render "masks/server/account/signing_in", actor: @actor, passkeys: @passkeys,
                                                code_factors: @code_factors %>

  <%= render "masks/server/account/approve", approver: @approver, approving: @approving %>

  <%= render "masks/server/account/devices", devices: @devices, trusted: @trusted, live: @live %>

  <%= render "masks/server/account/apps", apps: @apps, connections: @connections, linkable: @linkable %>

  <%= render "masks/server/account/info", actor: @actor %>

  <%= render "masks/server/account/activity", events: @events %>
</div>
