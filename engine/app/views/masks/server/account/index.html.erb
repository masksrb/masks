<% content_for :title, Masks::Server::Current.tenant&.name %>

<% content_for :surface, "place" %>

<% content_for :scripts do %>
  <%= vite_javascript_tag "account" %>
<% end %>

<div id="account" class="place">
  <%= render "masks/server/account/head", actor: @actor %>

  <% if @launchable.any? %>
    <%= render "masks/server/account/launcher", clients: @launchable %>
  <% end %>

  <%= render "masks/server/account/signing_in", actor: @actor, passkeys: @passkeys,
                                                code_factors: @code_factors, fresh: @fresh,
                                                authenticator: @authenticator,
                                                authenticator_secret: @authenticator_secret,
                                                backup_codes: @backup_codes,
                                                pending_addresses: @pending_addresses,
                                                directed: @directed %>

  <%= render "masks/server/account/approve", approver: @approver, approving: @approving %>

  <%= render "masks/server/account/devices", devices: @devices, trusted: @trusted, live: @live %>

  <% if @memberships.any? || @invitations.any? %>
    <%= render "masks/server/account/organizations", memberships: @memberships, invitations: @invitations %>
  <% end %>

  <%= render "masks/server/account/apps", apps: @apps, connections: @connections, linkable: @linkable %>

  <% if @app_passwords.any? || @app_password_clients.any? %>
    <%= render "masks/server/account/app_passwords", app_passwords: @app_passwords, offered: @app_password_clients,
                                                     app_password: @app_password, fresh: @fresh %>
  <% end %>

  <%= render "masks/server/account/info", actor: @actor, directed: @directed, fresh: @fresh %>

  <%= render "masks/server/account/activity", events: @events %>

  <%= render "masks/server/account/export", fresh: @fresh %>

  <%= render "masks/server/account/delete", actor: @actor, fresh: @fresh, refusal: @refusal %>
</div>
