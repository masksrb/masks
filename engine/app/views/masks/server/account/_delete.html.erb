<section class="group" id="delete">
  <div class="entries">
    <details class="entry">
      <summary>
        <span class="entry-icon"><%= account_icon(:close) %></span>
        <span class="entry-label"><%= account_text("delete.heading") %></span>
        <span class="entry-state"><%= account_text("delete.state") %></span>
        <span class="entry-mark" aria-hidden="true"></span>
      </summary>

      <div class="entry-body">
        <p class="aside"><%= account_text("delete.lede") %></p>

        <% if refusal %>
          <p class="aside aside-bad"><%= t("account_deletion.#{refusal}") %></p>
        <% else %>
          <% unless fresh %>
            <p class="aside"><%= account_text("delete.again") %></p>
          <% end %>

          <%= form_with url: account_path, method: :delete, id: "delete-account", class: "flow-tight" do |form| %>
            <% if fresh %>
              <label class="field">
                <span class="field-label"><%= account_text("delete.confirm_html", identifier: actor.identifier) %></span>
                <%= form.text_field :confirm, autocomplete: "off", spellcheck: false, required: true,
                      class: "control" %>
              </label>
            <% end %>

            <div class="action-row">
              <button type="submit" class="action action-sm">
                <%= account_text(fresh ? "delete.submit" : "delete.submit_again") %>
              </button>
            </div>
          <% end %>
        <% end %>
      </div>
    </details>
  </div>
</section>
