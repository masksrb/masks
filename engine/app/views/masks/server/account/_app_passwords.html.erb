<section class="group" id="app-passwords">
  <h2><%= account_text("app_passwords.heading") %></h2>

  <div class="entries">
    <details class="entry" <%= "open" if app_password %>>
      <summary>
        <span class="entry-icon"><%= account_icon(:password) %></span>
        <span class="entry-label"><%= account_text("app_passwords.entry") %></span>
        <span class="entry-state">
          <%= app_passwords.any? ? app_passwords.size : account_text("app_passwords.state.none") %>
        </span>
        <span class="entry-mark" aria-hidden="true"></span>
      </summary>

      <div class="entry-body">
        <p class="aside"><%= account_text("app_passwords.lede") %></p>

        <% if app_password %>
          <p class="aside aside-bad" role="alert">
            <%= account_text("app_passwords.shown_once", name: app_password["name"], app: app_password["app"]) %>
          </p>

          <ol class="codes">
            <li><code><%= app_password["secret"] %></code></li>
          </ol>
        <% end %>

        <% if app_passwords.any? %>
          <div class="items">
            <% app_passwords.each do |held| %>
              <div class="item">
                <span class="item-name">
                  <span><%= held.name %></span>
                  <span class="tag"><%= held.client.name %></span>
                </span>

                <span class="item-meta">
                  <%= account_text("app_passwords.made_ago", age: time_ago_in_words(held.created_at)) %>
                  ·
                  <% if held.used_at %>
                    <%= account_text("app_passwords.used_ago", age: time_ago_in_words(held.used_at)) %>
                  <% else %>
                    <%= account_text("app_passwords.never_used") %>
                  <% end %>
                </span>

                <%= button_to account_text("app_passwords.revoke"),
                      account_app_password_path(held.id), method: :delete,
                      class: "action action-quiet action-sm", form_class: "item-act",
                      form: { data: { turbo_confirm: account_text("app_passwords.confirm_revoke", name: held.name) } } %>
              </div>
            <% end %>
          </div>
        <% end %>

        <% if offered.any? %>
          <%= form_with url: account_app_passwords_path, method: :post, class: "member-add" do |form| %>
            <label class="field member-add-email">
              <span class="field-label"><%= account_text("app_passwords.name") %></span>
              <%= form.text_field :name, required: true, autocomplete: "off", class: "control", id: "app-password-name",
                                  maxlength: Masks::Server::AppPassword::NAME_LIMIT,
                                  placeholder: account_text("app_passwords.name_placeholder") %>
            </label>

            <label class="field member-add-role">
              <span class="field-label"><%= account_text("app_passwords.app") %></span>
              <%= form.select :client_id, offered.map { |client| [ client.name, client.client_id ] }, {}, class: "control",
                              id: "app-password-client" %>
            </label>

            <button type="submit" class="action action-sm member-add-go">
              <%= account_text(fresh ? "app_passwords.make" : "app_passwords.make_again") %>
            </button>

            <span class="field-hint member-add-hint"><%= account_text("app_passwords.hint") %></span>
          <% end %>
        <% else %>
          <p class="aside"><%= account_text("app_passwords.none_offered") %></p>
        <% end %>
      </div>
    </details>
  </div>
</section>
