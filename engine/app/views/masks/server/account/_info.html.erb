<section class="group" id="info">
  <h2><%= account_text("info.heading") %></h2>

  <div class="entries">
    <details class="entry" id="profile">
      <summary>
        <span class="entry-icon"><%= account_icon(:person) %></span>
        <span class="entry-label"><%= account_text("profile.heading") %></span>
        <span class="entry-state"><%= actor.name.presence || actor.nickname %></span>
        <span class="entry-mark" aria-hidden="true"></span>
      </summary>

      <div class="entry-body">
        <% if directed %>
          <p class="aside"><%= account_text("profile.directed") %></p>
        <% else %>
          <%= form_with url: account_profile_path, method: :patch, id: "profile-form", class: "flow-tight" do |form| %>
            <label class="field">
              <span class="field-label"><%= account_text("profile.name") %></span>
              <%= form.text_field :name, value: actor.name, autocomplete: "name", class: "control" %>
            </label>

            <label class="field">
              <span class="field-label"><%= account_text("profile.nickname") %></span>
              <%= form.text_field :nickname, value: actor.nickname, autocomplete: "username",
                    autocapitalize: "none", spellcheck: false, class: "control" %>
              <span class="field-hint"><%= account_text("profile.nickname_hint") %></span>
            </label>

            <div class="action-row">
              <button type="submit" class="action action-sm"><%= account_text("profile.submit") %></button>
            </div>
          <% end %>
        <% end %>
      </div>
    </details>

    <details class="entry" id="notifications">
      <summary>
        <span class="entry-icon"><%= account_icon(:bell) %></span>
        <span class="entry-label"><%= account_text("notifications.heading") %></span>
        <span class="entry-state">
          <%= account_text("notifications.state", count: actor.muted_notifications.size) %>
        </span>
        <span class="entry-mark" aria-hidden="true"></span>
      </summary>

      <div class="entry-body">
        <p class="aside"><%= account_text("notifications.lede") %></p>

        <% unless Masks::Server::Notifications.mailable?(actor) %>
          <p class="aside aside-bad"><%= account_text("notifications.silent") %></p>
        <% end %>

        <%= form_with url: account_notifications_path, method: :patch, class: "flow-tight" do |form| %>
          <%= hidden_field_tag "notifications[]", "" %>

          <% Masks::Server::Notifications::GROUPS.each do |group, actions| %>
            <fieldset class="switch-set">
              <legend><%= t("notifications.groups.#{group}") %></legend>

              <div class="switches">
                <% actions.each do |action| %>
                  <label class="switch">
                    <span><%= t("events.actions.#{action}") %></span>
                    <%= check_box_tag "notifications[]", action, actor.notified?(action),
                          id: "notify-#{action.tr('.', '-')}" %>
                  </label>
                <% end %>
              </div>
            </fieldset>
          <% end %>

          <div class="action-row">
            <button type="submit" class="action action-sm"><%= account_text("notifications.submit") %></button>
          </div>
        <% end %>
      </div>
    </details>
  </div>
</section>
