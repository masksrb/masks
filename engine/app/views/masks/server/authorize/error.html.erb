<% content_for :title, t(".page_title") %>
<% content_for :surface, "terminus" %>

<div id="authorize-error" class="flow" data-error="<%= @error_code %>">
  <span class="state state-bad"><%= t(".stopped") %></span>

  <h1 class="prompt-title"><%= @refused ? t(".refused") : t(".heading") %></h1>

  <p class="said"><%= @error_code %> — <%= @error_description %></p>

  <p class="prompt-lede"><%= @refused ? t(".nothing_shared") : t(".contact") %></p>

  <% if @asking %>
    <div id="ask-access" class="flow" data-waiting="<%= @waiting.present? %>">
      <% if flash[:alert].present? %>
        <p class="note note-bad" role="alert"><%= flash[:alert] %></p>
      <% elsif flash[:notice].present? %>
        <p class="note note-plain" role="status"><%= flash[:notice] %></p>
      <% end %>

      <% if @waiting %>
        <p class="prompt-lede"><%= t(".waiting", app: @asking.name) %></p>
      <% else %>
        <p class="prompt-lede"><%= t(".asking", app: @asking.name) %></p>

        <%= form_with url: authorize_access_request_path, method: :post do |form| %>
          <%= form.hidden_field :rid, value: params[:rid] %>
          <button type="submit" class="action"><%= t(".ask") %></button>
        <% end %>
      <% end %>
    </div>
  <% end %>

  <% if @return_to %>
    <a class="action action-quiet" id="back-to-app" href="<%= @return_to %>"><%= t(".back", app: @asking&.name || t(".the_app")) %></a>
  <% end %>
</div>
