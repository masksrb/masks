<% protection = login.as_json["protection"] %>
<% otp = protection["otp"] %>
<% issued = protection.dig("backupCodes", "issued") || [] %>
<% remaining = protection.dig("backupCodes", "remaining").to_i %>
<% signing_up = login.signing_up %>
<% offers = protection["offers"] %>

<div class="flow<%= " setup" if signing_up %>">
  <% if signing_up %>
    <%= render "masks/server/logins/signup_head", login: login, at: 2 %>

    <p class="aside"><%= protection["required"] ? t(".lede") : t(".lede_optional") %></p>
  <% else %>
    <%= render "masks/server/logins/head", title: t(".title"),
          lede: protection["required"] ? t(".lede") : t(".lede_optional") %>

    <%= render "masks/server/logins/identified", login: login %>
  <% end %>

  <div class="slab">
    <% if offers["otp"] %>
    <div class="ledger-row ledger-step<%= " ledger-step-done" if otp["enabled"] %>">
      <span class="ledger-label"><%= t(".otp") %></span>

      <% if otp["enabled"] %>
        <span class="ledger-value"><%= t(".otp_on") %></span>
      <% else %>
        <div class="protect">
          <a class="protect-qr" href="<%= otp["uri"] %>" aria-label="<%= t(".open") %>"><%= otp["qr"].html_safe %></a>
          <div class="protect-key">
            <span class="field-hint"><%= t(".scan_hint") %></span>
            <span class="aside-mono protect-secret"><%= otp["secret"] %></span>
          </div>
        </div>

        <%= render "masks/server/logins/protect_code_form", login: login, event: "protect:otp", id: "protect-otp" %>
      <% end %>
    </div>
    <% end %>

    <% (protection["codes"] || {}).each do |factor, row| %>
    <div class="ledger-row ledger-step<%= " ledger-step-done" if row["enabled"] %>">
      <span class="ledger-label"><%= t(".codes_#{factor}") %></span>

      <% if row["enabled"] %>
        <span class="ledger-value"><%= t(".otp_on") %></span>
      <% elsif row["sent"] %>
        <span class="field-hint"><%= t(".sent_to", to: row["to"]) %></span>

        <%= render "masks/server/logins/protect_code_form", login: login, event: "protect:code", id: "protect-#{factor}-code" %>
      <% else %>
        <span class="field-hint"><%= t(".codes_#{factor}_hint", to: row["to"]) %></span>

        <%= form_with url: login_path, method: :post, id: "protect-send-#{factor}-code", class: "flow-tight" do |form| %>
          <%= hidden_field_tag :rid, login.rid %>
          <%= form.hidden_field :event, value: "protect:code-send" %>
          <%= form.hidden_field :factor, value: factor %>
          <button type="submit" class="action action-quiet"><%= t(".send_code") %></button>
        <% end %>
      <% end %>
    </div>
    <% end %>

    <% if offers["backupCodes"] %>
    <div class="ledger-row ledger-step<%= " ledger-step-done" if issued.any? || remaining.positive? %>">
      <span class="ledger-label"><%= t(".backup_codes") %></span>

      <% if issued.any? %>
        <ol class="codes">
          <% issued.each do |held| %>
            <li class="aside-mono"><%= held %></li>
          <% end %>
        </ol>
        <span class="field-hint"><%= t(".backup_codes_hint") %></span>
        <% saved = [ t(".backup_codes_file", account: login.actor&.identifier.to_s, origin: Masks::Server::Current.origin), t(".backup_codes_hint"), "", *issued, "" ].join("\n") %>
        <div class="codes-actions">
          <a class="textlink" href="data:text/plain;charset=utf-8,<%= ERB::Util.url_encode(saved) %>" download="backup-codes-<%= request.host %>.txt"><%= t(".download") %></a>
        </div>
      <% elsif remaining.positive? %>
        <span class="field-hint"><%= t(".backup_codes_left", count: remaining) %></span>
      <% else %>
        <span class="field-hint"><%= t(".backup_codes_waiting") %></span>
      <% end %>
    </div>
    <% end %>
  </div>

  <%= form_with url: login_path, method: :post, id: "protect-done", class: "flow" do |form| %>
    <%= hidden_field_tag :rid, login.rid %>
    <%= form.hidden_field :event, value: "protect:done" %>

    <% if issued.any? %>
      <label class="check">
        <%= check_box_tag :kept, "1", false, required: true %>
        <span><%= t(".kept") %></span>
      </label>
    <% end %>

    <button type="submit" class="action">
      <%= otp["enabled"] || protection.dig("passkeys", "count").to_i.positive? || protection["required"] ? t(".done") : t(".skip") %>
    </button>
  <% end %>
</div>
