<%= render "masks/server/logins/head", title: t(".title"), lede: t(".lede", identifier: login.identifier) %>

<%= render "masks/server/logins/identified", login: login %>

<%= render "masks/server/logins/code_form", login: login, event: "email-code:verify" %>

<%= render "masks/server/logins/resend", login: login, event: "email-code:send", label: t(".send_again") %>
