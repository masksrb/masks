<% client = login.client&.name %>

<%= render "masks/server/logins/head",
           title: client ? t(".title_to", client: client) : t(".title"),
           lede: t(".lede") %>

<%= render "masks/server/application/person", actor: login.actor, sign_out: true if login.actor %>

<div class="providers">
  <% (login.as_json["organizations"] || []).each do |organization| %>
    <%= form_with url: login_path, method: :post, class: "contents" do |form| %>
      <%= hidden_field_tag :rid, login.rid %>
      <%= form.hidden_field :event, value: "organization" %>
      <%= form.hidden_field :organization, value: organization["key"] %>

      <button type="submit" class="action action-quiet">
        <%= t(".as", organization: organization["name"], role: organization["role"]) %>
      </button>
    <% end %>
  <% end %>
</div>
