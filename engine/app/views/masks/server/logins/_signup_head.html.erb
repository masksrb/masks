<% tenant = Masks::Server::Current.tenant&.name.to_s %>
<% signing_up = login.signing_up %>

<% if signing_up["firstRun"] %>
  <%= render "masks/server/logins/head", cap: t("logins.signing_up.setup_cap"), title: t("logins.signing_up.setup_title"), name: tenant %>
<% else %>
  <%= render "masks/server/logins/head", title: t("logins.signing_up.signup_title") %>
<% end %>

<%= render "masks/server/logins/steps", steps: signing_up["steps"], at: local_assigns[:at] || signing_up["steps"].length %>
