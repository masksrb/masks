<% tenant = Masks::Server::Current.tenant&.name.to_s %>
<% signing_up = login.signing_up %>

<div class="auth-pair">
  <span class="auth-mark auth-mark-client<%= " auth-mark-pending" if mark.blank? %>" aria-hidden="true"><%= mark.to_s.first&.upcase %></span>
  <span class="auth-wire"></span>
  <% if signing_up["firstRun"] %>
    <img src="/masks-public/icon.svg" alt="" class="auth-mark auth-mark-rose">
  <% else %>
    <span class="auth-mark" aria-hidden="true"><%= tenant.first&.upcase %></span>
  <% end %>
</div>

<% if signing_up["firstRun"] %>
  <%= render "masks/server/logins/head", cap: t("logins.signing_up.setup_cap"), title: t("logins.signing_up.setup_title"), name: tenant %>
<% else %>
  <%= render "masks/server/logins/head", title: t("logins.signing_up.signup_title"), name: tenant %>
<% end %>

<%= render "masks/server/logins/steps", steps: signing_up["steps"], at: local_assigns[:at] || signing_up["steps"].length %>
