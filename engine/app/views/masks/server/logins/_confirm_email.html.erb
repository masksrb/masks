<% confirmation = login.as_json["confirmation"] %>
<% linked = confirmation["mode"] == "link" %>

<%= render "masks/server/logins/confirm_head", login: login, title: t(".title"),
      lede: t(linked ? ".lede_link" : ".lede", email: confirmation["email"]) %>

<% if !confirmation["mails"] %>
  <p class="note note-warn" role="alert"><%= t(".no_mailer") %></p>
<% elsif linked %>
  <%= form_with url: login_path, method: :post, class: "flow" do |form| %>
    <%= hidden_field_tag :rid, login.rid %>
    <%= form.hidden_field :event, value: "confirm:check" %>
    <button type="submit" class="action"><%= t("logins.shared.continue") %></button>
  <% end %>
<% else %>
  <%= render "masks/server/logins/code_form", login: login, event: "confirm:email" %>
<% end %>

<%= render "masks/server/logins/resend", login: login if confirmation["mails"] %>
