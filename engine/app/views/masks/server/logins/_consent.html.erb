<% state = login.state("consent") %>
<% client = login.client_json || {} %>
<% hot, rest = ranked_scopes(Masks::Server::ResourceMetadata.describe(state.audience, state.scopes)) %>
<% all = hot + rest %>

<div class="auth-solo">
  <% if client["logo"] %>
    <%= image_tag client["logo"], alt: "", class: "auth-mark auth-mark-client auth-mark-logo", referrerpolicy: "no-referrer" %>
  <% else %>
    <span class="auth-mark auth-mark-client" aria-hidden="true"><%= client["name"].to_s.strip.first&.upcase %></span>
  <% end %>
</div>

<%= render "masks/server/logins/head", title: t(".title", client: login.client&.name) %>

<%= render "masks/server/application/actor", actor: login.actor, sign_out: true if login.actor %>

<div class="slab">
  <div class="ledger-row">
    <span class="ledger-label"><%= t(".access") %></span>

    <% if all.empty? %>
      <p class="empty"><%= t(".no_access") %></p>
    <% else %>
      <ul class="plain-list">
        <% all.each do |_, description| %>
          <li><%= description %></li>
        <% end %>
      </ul>
    <% end %>
  </div>

  <% if state.audience.any? %>
    <div class="ledger-row">
      <span class="aside"><%= t(".audience", resources: state.audience.join(", ")) %></span>
    </div>
  <% end %>

  <% if (details = state.details&.described).present? %>
    <div class="ledger-row">
      <span class="ledger-label"><%= t(".details") %></span>
      <ul class="plain-list">
        <% details.each do |detail| %>
          <li>
            <%= detail["label"] %>
            <% if detail["fields"].any? %>
              <dl class="grant-fields">
                <% detail["fields"].each do |name, value| %>
                  <dt><%= name %></dt>
                  <dd class="aside-mono"><%= value %></dd>
                <% end %>
              </dl>
            <% end %>
          </li>
        <% end %>
      </ul>
    </div>
  <% end %>
</div>

<% links = { "site" => t(".site", client: client["name"]), "terms" => t(".terms"), "privacy" => t(".privacy") }.select { |key, _| client[key] } %>
<details class="disclosure handshake-more">
  <summary class="textlink"><%= t(".more") %></summary>

  <div class="slab">
    <div class="ledger-row">
      <span class="ledger-label"><%= t(".scopes") %></span>
      <ul class="grant-scopes">
        <% all.each do |scope, description| %>
          <li class="grant-scope">
            <span><%= description %></span>
            <span class="chip-key"><%= scope %></span>
          </li>
        <% end %>
      </ul>
    </div>

    <% if client["returnsTo"] %>
      <div class="ledger-row">
        <span class="ledger-label"><%= t(".returns_to") %></span>
        <span class="ledger-value aside-mono"><%= client["returnsTo"] %></span>
      </div>
    <% end %>

    <% if links.any? %>
      <p class="aside client-links">
        <% links.each do |key, label| %>
          <%= link_to label, client[key], class: "textlink", rel: "noopener noreferrer", target: "_blank" %>
        <% end %>
      </p>
    <% end %>
  </div>
</details>

<div class="action-row">
  <%= form_with url: login_path, method: :post, id: "consent", class: "action-grow" do |form| %>
    <%= hidden_field_tag :rid, login.rid %>
    <%= form.hidden_field :event, value: "consent" %>
    <%= form.hidden_field :approve, value: "yes" %>
    <button type="submit" class="action"><%= t(".allow") %></button>
  <% end %>

  <%= form_with url: login_path, method: :post, id: "decline" do |form| %>
    <%= hidden_field_tag :rid, login.rid %>
    <%= form.hidden_field :event, value: "decline" %>
    <button type="submit" class="action action-quiet action-fit"><%= t(".deny") %></button>
  <% end %>
</div>
