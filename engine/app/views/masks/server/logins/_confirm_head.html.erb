<% if login.journey %>
  <%= render "masks/server/logins/signup_head", login: login, mark: login.actor&.identifier.to_s %>

  <div class="prompt-head">
    <h2 class="prompt-title"><%= title %></h2>
    <% if local_assigns[:lede].present? %><p class="prompt-lede"><%= lede %></p><% end %>
  </div>
<% else %>
  <%= render "masks/server/logins/head", title: title, lede: local_assigns[:lede] %>

  <%= render "masks/server/logins/identified", login: login %>
<% end %>
