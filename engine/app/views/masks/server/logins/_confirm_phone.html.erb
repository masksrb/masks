<% confirmation = login.as_json["confirmation"] %>

<%= render "masks/server/logins/confirm_head", login: login, title: t(".title"), lede: t(".lede", phone: confirmation["phone"]) %>

<% if confirmation["texts"] %>
  <%= render "masks/server/logins/code_form", login: login, event: "confirm:phone" %>
  <%= render "masks/server/logins/resend", login: login %>
<% else %>
  <p class="note note-warn" role="alert"><%= t(".no_texts") %></p>
<% end %>

<%= form_with url: login_path, method: :post, class: "flow" do |form| %>
  <%= hidden_field_tag :rid, login.rid %>
  <%= form.hidden_field :event, value: "confirm:change-phone" %>
  <button type="submit" class="action action-plain"><%= t(".change_phone") %></button>
<% end %>
