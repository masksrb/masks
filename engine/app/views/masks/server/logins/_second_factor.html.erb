<% otp = login.actor&.otp? %>
<% backup_codes = login.actor&.backup_codes? %>
<% codes = login.state("code-factor") %>
<% code_json = codes.enabled? ? codes.as_json : {} %>
<% usable = code_json.fetch("codeFactors", {}) %>
<% sent = code_json["codeSent"] %>
<% trusted = login.state("trusted-device") %>
<% approval = trusted.enabled? ? trusted.as_json["approval"] : nil %>
<% approving = approval && !approval["denied"] && !approval["expired"] %>

<% if otp || backup_codes || usable.any? || trusted.enabled? %>
  <%= render "masks/server/logins/head", title: t(otp || sent ? ".title" : ".title_passkey"),
                                         lede: sent && t(".sent_to", to: sent["to"]) %>
<% else %>
  <% why = if code_json["codesWithheld"].present? then ".stuck_inbox"
           elsif login.actor&.verified_passkeys? then ".stuck_no_script"
           else ".stuck_nothing" end %>
  <noscript>
    <%= render "masks/server/logins/head", tone: "bad", title: t("logins.shared.halted"), lede: t(why) %>
  </noscript>
<% end %>

<%= render "masks/server/logins/identified", login: login %>

<% if otp || sent %>
  <%= form_with url: login_path, method: :post, id: "second-factor", class: "flow" do |form| %>
    <%= hidden_field_tag :rid, login.rid %>
    <%= form.hidden_field :event, value: sent ? "code:verify" : "otp" %>

    <label class="field">
      <span class="field-label"><%= t(".code") %></span>
      <%= form.text_field :code, inputmode: "numeric", pattern: "[0-9]*",
            autocomplete: "one-time-code", maxlength: 6, spellcheck: "false",
            class: "control control-code" %>
    </label>

    <% if login.device %>
      <label class="check">
        <%= form.check_box :remember %>
        <span><%= t(".trust", duration: distance_of_time_in_words(Masks::Server::DeviceFactor::LIFETIME)) %></span>
      </label>
    <% end %>

    <button type="submit" class="action"><%= t("logins.shared.continue") %></button>
  <% end %>
<% end %>

<% if approving %>
  <div class="slab flow-tight">
    <span class="aside-mono approval-code"><%= approval["code"].to_s.scan(/.{1,3}/).join(" ") %></span>
    <span class="field-hint"><%= t(".approval_code") %></span>
  </div>

  <%= form_with url: login_path, method: :post, id: "approval-check", class: "flow" do |form| %>
    <%= hidden_field_tag :rid, login.rid %>
    <%= form.hidden_field :event, value: "approval:check" %>
    <% if login.device %>
      <label class="check">
        <%= form.check_box :remember %>
        <span><%= t(".trust", duration: distance_of_time_in_words(Masks::Server::DeviceFactor::LIFETIME)) %></span>
      </label>
    <% end %>
    <button type="submit" class="action"><%= t(".approval_checked") %></button>
  <% end %>
<% elsif trusted.enabled? %>
  <%= form_with url: login_path, method: :post, id: "approval-request", class: "flow" do |form| %>
    <%= hidden_field_tag :rid, login.rid %>
    <%= form.hidden_field :event, value: "approval:request" %>
    <button type="submit" class="action action-plain">
      <%= approval ? t(".approval_again") : t(".use_trusted_device") %>
    </button>
  <% end %>
<% end %>

<% usable.each do |factor, to| %>
  <% next if sent && sent["factor"] == factor && !sent["resendable"] %>
  <%= form_with url: login_path, method: :post, id: "send-#{factor}-code", class: "flow" do |form| %>
    <%= hidden_field_tag :rid, login.rid %>
    <%= form.hidden_field :event, value: "code:send" %>
    <%= form.hidden_field :factor, value: factor %>
    <button type="submit" class="action action-plain">
      <%= sent && sent["factor"] == factor ? t(".send_again") : t(".send_#{factor}", to: to) %>
    </button>
  <% end %>
<% end %>

<% if backup_codes %>
  <%= form_with url: login_path, method: :post, id: "use-backup-code", class: "flow" do |form| %>
    <%= hidden_field_tag :rid, login.rid %>
    <%= form.hidden_field :event, value: "use-backup-code" %>
    <button type="submit" class="action action-plain"><%= t(".use_backup_code") %></button>
  <% end %>
<% end %>
