<%= form_with url: login_path, method: :post, class: "flow" do |form| %>
  <%= hidden_field_tag :rid, login.rid %>
  <%= form.hidden_field :event, value: local_assigns.fetch(:event, "confirm:resend") %>
  <button type="submit" class="action action-plain"><%= t("logins.signing_up.send_again") %></button>
<% end %>
