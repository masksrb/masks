<% if @message %>
<%= render "message" %>
<% else %>
<p class="lede"><%= @lede %></p>
<% end %>

<p class="lede"><%= t(".grants", organization: @organization.name, role: @role) %></p>

<% if @url %>
  <%= render "action", url: @url, label: t(".action") %>
<% end %>

<p class="meta"><%= t(".unexpected", organization: @organization.name) %></p>
