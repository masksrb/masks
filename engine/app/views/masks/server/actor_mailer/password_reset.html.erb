<% if @message %>
<%= render "message" %>
<% if @opened_by %>
<p class="lede"><%= t(".opened_by", nickname: @opened_by.identifier, tenant: @tenant_name) %></p>
<% end %>
<% else %>
<p class="lede">
  <%= @opened_by ? t(".opened_by", nickname: @opened_by.identifier, tenant: @tenant_name) :
        t(".opened", tenant: @tenant_name) %>
</p>
<% end %>

<%= render "action", url: @url, label: t(".action") %>

<p class="meta">
  <%= t(".expiry", duration: ActiveSupport::Duration.build(Masks::Server::PasswordReset.lifetime.to_i).inspect) %>
</p>
