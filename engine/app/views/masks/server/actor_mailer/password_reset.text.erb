<% if @message %>
<%= render "message" %>
<% if @opened_by %>

<%= t(".opened_by", nickname: @opened_by.identifier, tenant: @tenant_name) %>
<% end %>
<% else %>
<%= @opened_by ? t(".opened_by", nickname: @opened_by.identifier, tenant: @tenant_name) : t(".opened", tenant: @tenant_name) %>
<% end %>

<%= @url %>

<%= t(".expiry", duration: ActiveSupport::Duration.build(Masks::Server::PasswordReset.lifetime.to_i).inspect) %>
