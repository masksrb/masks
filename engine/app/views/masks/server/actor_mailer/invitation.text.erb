<% if @organization %><%= @invited_by ? t(".organization_by", nickname: @invited_by.identifier, organization: @organization.name, role: @role) : t(".organization", organization: @organization.name, role: @role) %><% else %><%= @invited_by ? t(".invited_by", nickname: @invited_by.identifier, tenant: @tenant_name) : t(".invited", tenant: @tenant_name) %><% end %>

<% if @actor.nickname.present? %><%= t(".nickname", nickname: @actor.nickname) %><% end %>

<%= @url %>
<% if @organization %>

<%= t(".organization_after", organization: @organization.name) %>
<% end %>

<%= t(".expiry", duration: ActiveSupport::Duration.build(Masks::Server::Invitation.lifetime.to_i).inspect) %>
