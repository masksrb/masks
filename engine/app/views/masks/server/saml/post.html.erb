<% content_for :title, t(@leaving ? ".leaving_title" : ".page_title") %>
<% content_for :surface, "terminus" %>

<div id="saml-post" class="flow">
  <h1 class="prompt-title"><%= t(@leaving ? ".leaving" : ".heading", name: @client.name) %></h1>

  <form id="saml-message" method="post" action="<%= @destination %>" class="flow">
    <input type="hidden" name="<%= @saml_field %>" value="<%= @saml_message %>">
    <% if @relay_state %>
      <input type="hidden" name="RelayState" value="<%= @relay_state %>">
    <% end %>
    <button type="submit" class="action"><%= t(".continue") %></button>
  </form>

  <script nonce="<%= @script_nonce %>">document.getElementById("saml-message").submit()</script>
</div>
