<!DOCTYPE html>
<html lang="<%= Masks::Server::Locales.tag %>" data-theme="rose">
  <head>
    <title><%= content_for(:title) || "Manage #{Masks::Server::Current.tenant&.name}" %></title>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
    <meta name="masks-root" content="<%= request.script_name %>">
    <meta name="color-scheme" content="dark">
    <link rel="icon" href="/masks-public/favicon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/masks-public/icon.png">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= vite_client_tag %>
    <%= vite_stylesheet_tag "app" %>
    <%= vite_stylesheet_tag "console" %>
    <%= vite_javascript_tag "manage" %>
  </head>

  <body class="console min-h-screen bg-base-200">
    <%= yield %>
  </body>
</html>
