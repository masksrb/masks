{
  "alias": "masks",
  "description": "masks \u2014 a tenant of a masks deployment, registered dynamically",
  "server": {
    "discoveryUrl": "https://demo.masks.test/.well-known/openid-configuration"
  },
  "client": {
    "client_name": "conformance-first"
  },
  "client2": {
    "client_name": "conformance-second"
  },
  "browser": [
    {
      "match": "https://demo.masks.test/authorize*",
      "tasks": [
        {
          "task": "Answer whatever masks asks",
          "optional": true,
          "match": "https://demo.masks.test/*",
          "commands": [
            [
              "wait",
              "css",
              "#login, #authorize-error",
              10,
              ".",
              "update-image-placeholder-optional"
            ],
            ["text", "name", "identifier", "owner", "optional"],
            ["click", "css", "form#identify button.action", "optional"],
            ["text", "name", "password", "password", "optional"],
            ["click", "css", "form#first-factor button.action", "optional"],
            ["click", "css", "form#consent button.action", "optional"]
          ]
        },
        {
          "task": "Verify Complete",
          "optional": true,
          "match": "https://localhost.emobix.co.uk:8443/test/*/callback*",
          "commands": [["wait", "id", "submission_complete", 10]]
        }
      ]
    }
  ]
}
