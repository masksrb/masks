{
  "alias": "masks",
  "description": "masks — a tenant of a masks deployment, registered dynamically",
  "server": {
    "discoveryUrl": "https://demo.masks.test/.well-known/openid-configuration"
  },
  "client": {
    "client_name": "conformance-first"
  },
  "client2": {
    "client_name": "conformance-second"
  },
  "browser": [
    {
      "match": "https://demo.masks.test/authorize*",
      "tasks": [
        {
          "task": "Sign in",
          "optional": true,
          "match": "https://demo.masks.test/login*",
          "commands": [
            ["wait", "css", "#login", 10, ".", "update-image-placeholder-optional"],
            ["wait", "name", "identifier", 10],
            ["text", "name", "identifier", "owner"],
            ["click", "css", "form#identify button[type=submit]"],
            ["wait", "name", "password", 10],
            ["text", "name", "password", "password"],
            ["click", "css", "form#first-factor button[type=submit]"]
          ]
        },
        {
          "task": "Consent",
          "optional": true,
          "match": "https://demo.masks.test/consent*",
          "commands": [
            ["click", "name", "approve"]
          ]
        },
        {
          "task": "Read the error page",
          "optional": true,
          "match": "https://demo.masks.test/authorize*",
          "commands": [
            ["wait", "css", "#authorize-error", 10, ".", "update-image-placeholder-optional"]
          ]
        },
        {
          "task": "Verify Complete",
          "optional": true,
          "match": "https://localhost.emobix.co.uk:8443/test/*/callback*",
          "commands": [
            ["wait", "id", "submission_complete", 10]
          ]
        }
      ]
    }
  ]
}
