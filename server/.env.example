MASKS_HOST_SUFFIX=auth.test
MASKS_TENANT=
MASKS_TENANTS=jons,acme
PORT=5555

POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5435
POSTGRES_USER=masks
POSTGRES_PASSWORD=masks

ENCRYPTION_PRIMARY_KEY=dev_only_primary_key_not_for_real_credentials
ENCRYPTION_DETERMINISTIC_KEY=dev_only_deterministic_key_not_for_real_use
ENCRYPTION_KEY_DERIVATION_SALT=dev_only_key_derivation_salt_not_for_real

MASKS_PUBLIC_ORIGIN_TEMPLATE=

# Set when the linked pg_dump is older than the server in compose.yml,
# e.g. /opt/homebrew/opt/postgresql@17/bin. The schema is dumped as SQL because
# schema.rb cannot represent row-level security policies.
PG_BIN_PATH=
