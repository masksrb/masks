#!/bin/bash
set -euo pipefail
trap 'kill 0' EXIT

cmp -s /web/package-lock.json /web/node_modules/.lock-stamp || {
  (cd /web && npm ci && cp package-lock.json node_modules/.lock-stamp)
}

npm --prefix /web exec -- tsc -p /web/tsconfig.json \
  --watch --preserveWatchOutput --watchFile dynamicPriorityPolling &

bin/vite dev &

wait -n
