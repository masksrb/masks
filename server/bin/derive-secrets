#!/usr/bin/env ruby
# frozen_string_literal: true

# Prints "export NAME=value" for each of SECRET_KEY_BASE and the three
# ENCRYPTION_ keys that isn't already set in the environment. Each is derived
# from one master key with HKDF-SHA256, a distinct label per name, so backing
# up and rotating one file covers all four. Called from bin/docker-entrypoint
# before Rails boots — nothing here depends on the Rails app being loaded.

require "openssl"
require "securerandom"
require "fileutils"

DERIVED = {
  "SECRET_KEY_BASE" => "masks/secret_key_base",
  "ENCRYPTION_PRIMARY_KEY" => "masks/encryption/primary_key",
  "ENCRYPTION_DETERMINISTIC_KEY" => "masks/encryption/deterministic_key",
  "ENCRYPTION_KEY_DERIVATION_SALT" => "masks/encryption/key_derivation_salt"
}.freeze

needed = DERIVED.keys.select { |name| ENV[name].to_s.empty? }
exit if needed.empty?

master_key = ENV["MASKS_MASTER_KEY"]
master_key = nil if master_key.to_s.empty?

unless master_key
  path = ENV["MASKS_MASTER_KEY_FILE"].to_s.empty? ? "/rails/storage/master.key" : ENV["MASKS_MASTER_KEY_FILE"]

  if File.exist?(path)
    master_key = File.read(path).strip
  else
    master_key = SecureRandom.hex(32)
    FileUtils.mkdir_p(File.dirname(path))
    File.write(path, master_key)
    File.chmod(0600, path)
  end
end

raw_key = [master_key].pack("H*")

needed.each do |name|
  derived = OpenSSL::KDF.hkdf(raw_key, salt: "", info: DERIVED.fetch(name), length: 64, hash: "SHA256")
  puts "export #{name}=#{derived.unpack1('H*')}"
end
