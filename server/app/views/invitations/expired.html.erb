<% content_for :title, "This invitation is no longer valid" %>

<div class="flex flex-col gap-4">
  <h1 class="text-2xl font-bold">This invitation is no longer valid</h1>

  <p class="text-sm opacity-75">
    Invitations work once and expire. This one has already been accepted, or it
    has been open long enough to lapse, or it was replaced by a newer one.
  </p>

  <p class="text-sm opacity-75">
    Nothing has changed on your account. Ask whoever invited you to send another.
  </p>

  <p><%= link_to "Go to sign in", login_path, class: "link text-sm" %></p>
</div>
