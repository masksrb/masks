<% content_for :title, t(".page_title", name: @handshake.name) %>
<% content_for :surface, "grant" %>

<% hot, rest = ranked_scopes(@scopes) %>

<div class="auth-pair">
  <span class="auth-mark auth-mark-client" aria-hidden="true"><%= @handshake.name.to_s.first&.upcase %></span>
  <span class="auth-wire"></span>
  <span class="auth-mark" aria-hidden="true"><%= Current.tenant&.name.to_s.first&.upcase %></span>
</div>

<div class="prompt-head">
  <h1 class="prompt-title">
    <%= @existing ? t(".title_again", name: @handshake.name) : t(".title", name: @handshake.name) %>
  </h1>
</div>

<% if @existing %>
  <div class="note note-warn" role="alert"><%= t(".replaces", name: @handshake.name) %></div>
<% end %>

<div class="slab">
  <div class="ledger-row">
    <span class="ledger-label"><%= t(".access") %></span>
    <ul class="grant-scopes">
      <% hot.each do |scope, description| %>
        <li class="grant-scope grant-scope-hot">
          <span><%= description %></span>
          <span class="chip-key"><%= scope %></span>
        </li>
      <% end %>

      <% if hot.any? && rest.any? %>
        <li class="grant-scope-split"></li>
      <% end %>

      <% rest.each do |scope, description| %>
        <li class="grant-scope">
          <span><%= description %></span>
          <span class="chip-key"><%= scope %></span>
        </li>
      <% end %>
    </ul>

    <% if @beneath.present? %>
      <details class="disclosure">
        <summary class="textlink"><%= t(".beneath", count: @beneath.size) %></summary>
        <ul class="grant-scopes">
          <% @beneath.each do |scope, description| %>
            <li class="grant-scope">
              <span><%= description %></span>
              <span class="chip-key"><%= scope %></span>
            </li>
          <% end %>
        </ul>
      </details>
    <% end %>
  </div>

  <% if @granting.present? %>
    <div class="ledger-row ledger-row-tight">
      <span class="ledger-label"><%= t(".claims") %></span>
      <span class="ledger-value">
        <%= t(".claimed", namespaces: @granting.to_sentence, name: @handshake.name) %>
      </span>
    </div>
  <% end %>

  <div class="ledger-row ledger-row-tight">
    <span class="ledger-label"><%= t(".origin") %></span>
    <span class="ledger-value aside-mono"><%= @handshake.origin %></span>
  </div>

  <div class="ledger-row ledger-row-tight">
    <span class="ledger-label"><%= t(".resource") %></span>
    <span class="ledger-value aside-mono"><%= @handshake.resource %></span>
  </div>

  <div class="ledger-row ledger-row-tight">
    <span class="ledger-label"><%= t(".returns") %></span>
    <% @handshake.redirect_uris.each do |uri| %>
      <span class="ledger-value aside-mono"><%= uri %></span>
    <% end %>
  </div>
</div>

<%= form_with url: handshake_path, method: :post do |form| %>
  <%= hidden_field_tag :hid, hid_for(@pending) %>
  <div class="action-row">
    <button type="submit" name="approve" value="yes" class="action action-grow"><%= t(".connect") %></button>
    <button type="submit" name="deny" value="yes" class="action action-quiet action-fit"><%= t(".cancel") %></button>
  </div>
<% end %>

<p class="aside"><%= current_actor.identifier %> · <%= link_to t(".sign_out"), logout_path, class: "textlink" %></p>
