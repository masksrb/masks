<% content_for :title, "Connect #{@handshake.name}" %>
<% content_for :surface, "grant" %>

<% hot, rest = ranked_scopes(@scopes) %>

<div class="auth-pair">
  <span class="auth-mark auth-mark-client" aria-hidden="true"><%= @handshake.name.to_s.first&.upcase %></span>
  <span class="auth-wire"></span>
  <span class="auth-mark" aria-hidden="true"><%= Current.tenant&.name.to_s.first&.upcase %></span>
</div>

<div class="prompt-head">
  <h1 class="prompt-title">
    <%= @existing ? "Reconnect" : "Connect" %> <%= @handshake.name %>?
  </h1>
</div>

<% if @existing %>
  <div class="note note-warn" role="alert">
    This replaces the credentials <%= @handshake.name %> holds now.
  </div>
<% end %>

<div class="slab">
  <div class="ledger-row">
    <span class="ledger-label">Access</span>
    <ul class="grant-scopes">
      <% hot.each do |scope, description| %>
        <li class="grant-scope grant-scope-hot">
          <span><%= description || "The #{scope} scope" %></span>
          <span class="chip-key"><%= scope %></span>
        </li>
      <% end %>

      <% if hot.any? && rest.any? %>
        <li class="grant-scope-split"></li>
      <% end %>

      <% rest.each do |scope, description| %>
        <li class="grant-scope">
          <span><%= description || "The #{scope} scope" %></span>
          <span class="chip-key"><%= scope %></span>
        </li>
      <% end %>
    </ul>
  </div>

  <% if @beneath.present? %>
    <div class="ledger-row">
      <span class="ledger-label">Which today is</span>
      <ul class="grant-scopes">
        <% @beneath.each do |scope, description| %>
          <li class="grant-scope">
            <span><%= description %></span>
            <span class="chip-key"><%= scope %></span>
          </li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <% if @granting.present? %>
    <div class="ledger-row">
      <span class="ledger-label">Claims</span>
      <span class="ledger-value">
        <%= @granting.to_sentence %> becomes <%= @handshake.name %>'s here, and is granted to you so
        you can use what you are connecting.
      </span>
    </div>
  <% end %>

  <div class="ledger-row">
    <span class="ledger-label">From</span>
    <span class="ledger-value aside-mono"><%= @handshake.origin %></span>
  </div>

  <div class="ledger-row">
    <span class="ledger-label">Signs you in at</span>
    <span class="ledger-value aside-mono"><%= @handshake.resource %></span>
  </div>

  <div class="ledger-row">
    <span class="ledger-label">Returns to</span>
    <% @handshake.redirect_uris.each do |uri| %>
      <span class="ledger-value aside-mono"><%= uri %></span>
    <% end %>
  </div>
</div>

<%= form_with url: handshake_path, method: :post do |form| %>
  <%= hidden_field_tag :hid, hid_for(@pending) %>
  <div class="action-row">
    <button type="submit" name="approve" value="yes" class="action action-grow">Connect</button>
    <button type="submit" name="deny" value="yes" class="action action-quiet action-fit">Cancel</button>
  </div>
<% end %>

<p class="aside"><%= current_actor.nickname %> · <%= link_to "Sign out", logout_path, class: "textlink" %></p>
