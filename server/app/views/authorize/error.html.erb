<% content_for :title, "This request cannot be completed" %>

<div id="authorize-error" class="flow" data-error="<%= @error_code %>">
  <h1 class="prompt-title"><%= t(".heading") %></h1>

  <p class="prompt-lede"><%= t(".explanation") %></p>

  <div class="note note-bad" role="alert">
    <span class="note-code"><%= @error_code %></span>
    <span><%= @error_description %></span>
  </div>

  <p class="aside"><%= t(".contact") %></p>
</div>
