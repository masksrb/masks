<% content_for :title, "This request cannot be completed" %>
<% content_for :surface, "terminus" %>

<div id="authorize-error" class="flow" data-error="<%= @error_code %>">
  <span class="state state-bad">Stopped</span>

  <h1 class="prompt-title"><%= t(".heading") %></h1>

  <p class="said"><%= @error_code %> — <%= @error_description %></p>

  <p class="prompt-lede"><%= t(".contact") %></p>
</div>
