<p class="lede">
  Confirm this address for <span class="strong"><%= @actor.nickname %></span>
  at <%= @tenant_name %>.
</p>

<%= render "action", url: @url, label: "Confirm this address" %>

<p class="meta">
  Works once, expires in
  <%= ActiveSupport::Duration.build(EmailVerification.lifetime.to_i).inspect %>.
  If this was not you, ignore it — nothing else changes.
</p>
