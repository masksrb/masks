<table role="presentation" class="btn-wrap" width="100%" cellpadding="0" cellspacing="0" border="0">
  <tr>
    <td>
      <table role="presentation" cellpadding="0" cellspacing="0" border="0">
        <tr>
          <td class="btn-cell" bgcolor="#b04000" align="center">
            <a class="btn" href="<%= url %>"><%= label %></a>
          </td>
        </tr>
      </table>
    </td>
  </tr>
</table>

<p class="fallback">
  Or paste this into your browser:<br>
  <%= link_to url, url %>
</p>
