<p class="lede">
  <%= @invited_by ? "#{@invited_by.nickname} invited you to #{@tenant_name}." : "You have been invited to #{@tenant_name}." %>
</p>

<p class="lede">
  Your username is <span class="strong"><%= @actor.nickname %></span>.
  Open the link to choose a password.
</p>

<%= render "action", url: @url, label: "Choose a password" %>

<p class="meta">
  Works once, expires in
  <%= ActiveSupport::Duration.build(Invitation.lifetime.to_i).inspect %>.
  Nothing happens until somebody opens it.
</p>
