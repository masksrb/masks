<p class="lede">
  <%= @invited_by ? t(".invited_by", nickname: @invited_by.nickname, tenant: @tenant_name) :
        t(".invited", tenant: @tenant_name) %>
</p>

<p class="lede">
  <%= t(".username_html", nickname: tag.span(@actor.nickname, class: "strong")) %>
</p>

<%= render "action", url: @url, label: t(".action") %>

<p class="meta">
  <%= t(".expiry", duration: ActiveSupport::Duration.build(Invitation.lifetime.to_i).inspect) %>
</p>
