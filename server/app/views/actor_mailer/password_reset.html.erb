<p>
  <%= @opened_by ? "#{@opened_by.nickname} started a password reset for your #{@tenant_name} account." : "Somebody asked to reset the password for your #{@tenant_name} account." %>
</p>

<p><%= link_to @url, @url %></p>

<p>
  Works once, expires in
  <%= ActiveSupport::Duration.build(PasswordReset.lifetime.to_i).inspect %>.
  Setting a new password signs you out everywhere else. If this was not you,
  ignore it — nothing has changed.
</p>
