<%= render "logins/header", key: "identify", login: login %>

<% identifies = login.as_json["identifies"] != false %>

<% if identifies %>
  <%= form_with url: login_path, method: :post, id: "identify", class: "flow" do |form| %>
    <%= hidden_field_tag :rid, login.rid %>
    <%= form.hidden_field :event, value: "identify" %>

    <label class="field">
      <span class="field-label"><%= t(".identifier") %></span>
      <%= form.text_field :identifier, value: login.identifier,
            autocomplete: "username", autocapitalize: "none", autocorrect: "off",
            spellcheck: "false", class: "control" %>
      <% if login.as_json["signupOpen"] %>
        <span class="field-hint"><%= t(".signup_hint") %></span>
      <% end %>
    </label>

    <button type="submit" class="action"><%= t("logins.shared.continue") %></button>
  <% end %>
<% end %>

<%= render "logins/providers", login: login, bare: !identifies %>
