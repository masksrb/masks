<%= render "logins/header",
      heading: login.tenant&.name ? "Log in to #{login.tenant.name}" : "Log in",
      login: login %>

<%= render "logins/warnings", login: login %>

<%= form_with url: login_path, method: :post, id: "identify", class: "flex flex-col gap-4" do |form| %>
  <%= form.hidden_field :event, value: "identify" %>

  <label class="flex flex-col gap-1.5">
    <span class="text-sm font-medium">Username or email</span>
    <%= form.text_field :identifier, value: login.identifier,
          autocomplete: "username", autocapitalize: "none", autocorrect: "off",
          spellcheck: "false", class: "input input-bordered w-full" %>
  </label>

  <button type="submit" class="btn btn-primary w-full">Continue</button>
<% end %>
