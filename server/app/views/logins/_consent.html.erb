<% state = login.state("consent") %>
<% hot, rest = ranked_scopes(ResourceMetadata.describe(state.audience, state.scopes)) %>

<div class="auth-pair">
  <span class="auth-mark auth-mark-client" aria-hidden="true"><%= login.client&.name.to_s.first&.upcase %></span>
  <span class="auth-wire"></span>
  <span class="auth-mark" aria-hidden="true"><%= Current.tenant&.name.to_s.first&.upcase %></span>
</div>

<%= render "logins/head", title: t(".title", client: login.client&.name) %>

<div class="slab">
  <div class="ledger-row">
    <span class="ledger-label"><%= t(".access") %></span>

    <% if hot.empty? && rest.empty? %>
      <p class="empty"><%= t(".no_access") %></p>
    <% end %>

    <ul class="grant-scopes">
      <% hot.each do |scope, description| %>
        <li class="grant-scope grant-scope-hot">
          <span><%= description %></span>
          <span class="chip-key"><%= scope %></span>
        </li>
      <% end %>

      <% if hot.any? && rest.any? %>
        <li class="grant-scope-split"></li>
      <% end %>

      <% rest.each do |scope, description| %>
        <li class="grant-scope">
          <span><%= description %></span>
          <span class="chip-key"><%= scope %></span>
        </li>
      <% end %>
    </ul>
  </div>

  <% if state.audience.any? %>
    <div class="ledger-row">
      <span class="ledger-label"><%= t(".audience") %></span>
      <% state.audience.each do |resource| %>
        <span class="ledger-value aside-mono"><%= resource %></span>
      <% end %>
    </div>
  <% end %>
</div>

<div class="action-row">
  <%= form_with url: login_path, method: :post, id: "consent", class: "action-grow" do |form| %>
    <%= hidden_field_tag :rid, login.rid %>
    <%= form.hidden_field :event, value: "consent" %>
    <%= form.hidden_field :approve, value: "yes" %>
    <button type="submit" class="action"><%= t(".allow") %></button>
  <% end %>

  <%= form_with url: login_path, method: :post, id: "decline" do |form| %>
    <%= hidden_field_tag :rid, login.rid %>
    <%= form.hidden_field :event, value: "decline" %>
    <button type="submit" class="action action-quiet action-fit"><%= t(".deny") %></button>
  <% end %>
</div>

<p class="aside"><%= login.actor&.nickname %> · <%= link_to t("logins.shared.sign_out"), logout_path, class: "textlink" %></p>
