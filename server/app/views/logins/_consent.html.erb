<% state = login.state("consent") %>

<div class="prompt-head">
  <h1 class="prompt-title"><%= login.client&.name %> wants access</h1>
  <p class="prompt-lede">
    Signed in as <strong><%= login.actor&.nickname %></strong>.
  </p>
</div>

<div class="ledger">
  <div class="ledger-row">
    <span class="ledger-label">It is asking to</span>
    <ul class="grant-scopes">
      <% ResourceMetadata.describe(state.audience, state.scopes).each do |scope, description| %>
        <li class="grant-scope">
          <span><%= description || "Use the #{scope} scope" %></span>
          <span class="chip-key"><%= scope %></span>
        </li>
      <% end %>
    </ul>
  </div>

  <% if state.audience.any? %>
    <div class="ledger-row">
      <span class="ledger-label">On your behalf at</span>
      <% state.audience.each do |resource| %>
        <span class="ledger-value aside-mono"><%= resource %></span>
      <% end %>
    </div>
  <% end %>
</div>

<div class="action-row">
  <%= form_with url: login_path, method: :post, id: "consent", class: "action-grow" do |form| %>
    <%= hidden_field_tag :rid, login.rid %>
    <%= form.hidden_field :event, value: "consent" %>
    <%= form.hidden_field :approve, value: "yes" %>
    <button type="submit" class="action">Allow</button>
  <% end %>

  <%= form_with url: login_path, method: :post, id: "decline" do |form| %>
    <%= hidden_field_tag :rid, login.rid %>
    <%= form.hidden_field :event, value: "decline" %>
    <button type="submit" class="action action-quiet action-fit">Deny</button>
  <% end %>
</div>

<p class="aside">Not you? <%= link_to "Sign out", logout_path, class: "textlink" %>.</p>
