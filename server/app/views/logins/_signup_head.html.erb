<% tenant = Current.tenant&.name.to_s %>
<% journey = login.journey %>

<div class="auth-pair">
  <span class="auth-mark auth-mark-client<%= " auth-mark-pending" if mark.blank? %>" aria-hidden="true"><%= mark.to_s.first&.upcase %></span>
  <span class="auth-wire"></span>
  <span class="auth-mark" aria-hidden="true"><%= tenant.first&.upcase %></span>
</div>

<% if journey["firstRun"] %>
  <%= render "logins/head", cap: t("logins.signing_up.setup_cap"), title: t("logins.signing_up.setup_title"), name: tenant %>
<% else %>
  <%= render "logins/head", title: t("logins.signing_up.signup_title"), name: tenant %>
<% end %>

<%= render "logins/steps", steps: journey["steps"], at: local_assigns[:at] || journey["steps"].length %>
