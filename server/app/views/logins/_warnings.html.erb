<% login.warnings.each do |warning| %>
  <% notice = t("logins.notices.#{warning}", default: nil) %>
  <% message = notice || t("logins.warnings.#{warning}", default: nil) %>
  <% if message %>
    <div class="alert <%= notice ? 'alert-info' : 'alert-error' %> text-sm" role="alert"><%= message %></div>
  <% end %>
<% end %>
