<% invitation = login.state("invitation").invitation %>

<div class="prompt-head">
  <h1 class="prompt-title">Accept your invitation</h1>
  <% if invitation.opened_by %>
    <p class="prompt-lede"><%= invitation.opened_by.nickname %> invited you.</p>
  <% end %>
</div>

<%= form_with url: login_path, method: :post, id: "accept-invitation", class: "flow" do |form| %>
  <%= hidden_field_tag :rid, login.rid %>
  <%= form.hidden_field :event, value: "accept-invitation" %>

  <label class="field">
    <span class="field-label">Username</span>
    <input type="text" value="<%= invitation.actor.nickname %>" readonly
           autocomplete="username" class="control" />
  </label>

  <% if invitation.actor.email.present? %>
    <label class="field">
      <span class="field-label">Email</span>
      <input type="email" value="<%= invitation.actor.email %>" readonly class="control" />
    </label>
  <% end %>

  <label class="field">
    <span class="field-label">Password</span>
    <%= form.password_field :password, autocomplete: "new-password", class: "control" %>
    <span class="field-hint">
      At least <%= LoginStates::Invitation::MINIMUM_PASSWORD %> characters.
    </span>
  </label>

  <button type="submit" class="action">Continue</button>
<% end %>
