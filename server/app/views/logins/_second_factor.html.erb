<%= render "logins/header", heading: "Enter your code", login: login %>

<%= render "logins/identified", login: login %>

<%= form_with url: login_path, method: :post, id: "second-factor", class: "flow" do |form| %>
  <%= hidden_field_tag :rid, login.rid %>
  <%= form.hidden_field :event, value: "otp" %>

  <label class="field">
    <span class="field-label">Six-digit code</span>
    <%= form.text_field :code, inputmode: "numeric", pattern: "[0-9]*",
          autocomplete: "one-time-code", maxlength: 6, spellcheck: "false",
          class: "control control-code" %>
    <span class="field-hint">From your authenticator app.</span>
  </label>

  <% if login.device %>
    <label class="check">
      <%= form.check_box :remember %>
      <span>
        Do not ask for a code on this device for
        <%= distance_of_time_in_words(DeviceFactor::LIFETIME) %>
      </span>
    </label>
  <% end %>

  <button type="submit" class="action">Verify</button>
<% end %>

<% if login.actor&.backup_codes? %>
  <%= form_with url: login_path, method: :post, id: "use-backup-code" do |form| %>
    <%= hidden_field_tag :rid, login.rid %>
    <%= form.hidden_field :event, value: "use-backup-code" %>
    <button type="submit" class="action action-plain">Use a backup code</button>
  <% end %>
<% end %>
