<% content_for :title, "Log in to #{Current.tenant&.name}" %>

<% content_for :scripts do %>
  <%= vite_client_tag %>
  <%= vite_javascript_tag "login" %>
<% end %>

<div id="login" class="flex flex-col gap-4" data-auth="<%= @login.as_json.to_json %>">
  <%= render "logins/#{@login.prompt.tr("-", "_")}", login: @login %>
</div>
