<% content_for :title, Current.tenant&.name ?
     t("logins.page.title_to", tenant: Current.tenant.name) : t("logins.page.title") %>

<% content_for :surface, "grant" if %w[consent setup setup-confirm].include?(@login.prompt) %>

<% content_for :scripts do %>
  <%= vite_client_tag %>
  <%= vite_javascript_tag "login" %>
<% end %>

<div id="login" class="flow" data-auth="<%= @login.as_json.to_json %>">
  <%= render "logins/warnings", login: @login %>
  <%= render "logins/#{@login.prompt.tr("-", "_")}", login: @login %>
</div>
