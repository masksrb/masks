<% content_for :title, "Log in to #{Current.tenant&.name}" %>

<% content_for :scripts do %>
  <%= vite_client_tag %>
  <%= vite_javascript_tag "login" %>
<% end %>

<div id="login" data-auth="<%= @login.as_json.to_json %>">
  <noscript>
    <div class="flex flex-col gap-2">
      <h1 class="text-2xl font-bold">JavaScript is required</h1>
      <p class="text-sm opacity-75">Signing in needs JavaScript enabled.</p>
    </div>
  </noscript>
</div>
