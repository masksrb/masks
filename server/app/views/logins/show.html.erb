<% content_for :title, Current.tenant&.name ? "Sign in to #{Current.tenant.name}" : "Sign in" %>

<% content_for :surface, "grant" if @login.prompt == "consent" %>
<% content_for :surface, "ceremony" if @login.prompt == "setup" %>

<% content_for :scripts do %>
  <%= vite_client_tag %>
  <%= vite_javascript_tag "login" %>
<% end %>

<div id="login" class="flow" data-auth="<%= @login.as_json.to_json %>">
  <%= render "logins/warnings", login: @login %>
  <%= render "logins/#{@login.prompt.tr("-", "_")}", login: @login %>
</div>
