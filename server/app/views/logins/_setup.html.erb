<% held = login.state("setup").as_json["setup"] %>
<% nickname = login.updates["nickname"].presence || held["nickname"].to_s %>
<% email = login.updates["email"].presence || held["email"].to_s %>
<% person = login.updates["name"].presence || held["name"].to_s %>
<% tenant = Current.tenant&.name.to_s %>
<% token_required = LoginStates::Setup.token_required? %>
<% steps = (token_required ? [ false ] : []) + [ nickname.present?, email.present? ] %>
<% stops = steps.size == 3 ? [ 1, 2, 3 ] : [ 1, 2 ] %>
<% step = ->(index) {
     "ledger-row ledger-step ledger-step-#{stops[index]}#{" ledger-step-done" if steps[index]}"
   } %>

<div class="setup flow">
  <div class="auth-pair">
    <span class="auth-mark auth-mark-client <%= "auth-mark-pending" if nickname.blank? %>" aria-hidden="true"><%= nickname.first&.upcase %></span>
    <span class="auth-wire"></span>
    <span class="auth-mark" aria-hidden="true"><%= tenant.first&.upcase %></span>
  </div>

  <%= render "logins/head", cap: t(".cap"), title: t(".title"), name: tenant %>

  <%= render "logins/setup_steps", at: 1 %>

  <%= form_with url: login_path, method: :post, id: "setup", class: "flow" do |form| %>
    <%= hidden_field_tag :rid, login.rid %>

    <div class="slab">
      <% if token_required %>
        <label class="<%= step.(0) %>">
          <span class="ledger-label"><%= t(".token") %></span>
          <%= form.password_field :token, autocomplete: "off", class: "control" %>
          <span class="field-hint"><%= t(".token_hint") %></span>
        </label>
      <% end %>

      <label class="<%= step.(token_required ? 1 : 0) %>">
        <span class="ledger-label"><%= t("logins.shared.nickname") %></span>
        <%= form.text_field :nickname, value: nickname,
              autocomplete: "username", autocapitalize: "none", autocorrect: "off",
              spellcheck: "false", class: "control" %>
      </label>

      <label class="<%= step.(token_required ? 2 : 1) %>">
        <span class="ledger-label"><%= t("logins.shared.email") %></span>
        <%= form.email_field :email, value: email, autocomplete: "email", class: "control" %>
      </label>

      <label class="ledger-row">
        <span class="ledger-label"><%= t("logins.shared.name") %></span>
        <%= form.text_field :name, value: person, autocomplete: "name", class: "control" %>
        <span class="field-hint"><%= t(".name_hint") %></span>
      </label>

      <div class="ledger-row">
        <span class="ledger-label"><%= t(".origin") %></span>
        <span class="ledger-value aside-mono"><%= Current.origin %></span>
      </div>
    </div>

    <button type="submit" name="event" value="setup" class="action">
      <%= t("logins.shared.continue") %>
    </button>
  <% end %>

  <p class="aside">
    <%= t(".once") %>
    <%= link_to t(".docs"), Rails.configuration.masks.docs_url,
          class: "textlink", rel: "noopener", target: "_blank" %>
  </p>
</div>
