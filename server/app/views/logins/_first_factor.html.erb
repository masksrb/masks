<%= render "logins/head", title: t(".title") %>

<%= render "logins/identified", login: login %>

<%= form_with url: login_path, method: :post, id: "first-factor", class: "flow" do |form| %>
  <%= hidden_field_tag :rid, login.rid %>
  <%= form.hidden_field :event, value: "password" %>

  <div class="field">
    <div class="field-line">
      <%= form.label :password, t("logins.shared.password"), class: "field-label" %>

      <button type="submit" form="forgot-password" class="textlink"><%= t(".forgot") %></button>
    </div>

    <%= form.password_field :password, autocomplete: "current-password", class: "control" %>
  </div>

  <button type="submit" class="action"><%= t("logins.shared.continue") %></button>
<% end %>

<%= form_with url: login_path, method: :post, id: "forgot-password" do |form| %>
  <%= hidden_field_tag :rid, login.rid %>
  <%= form.hidden_field :event, value: "forgot-password" %>
<% end %>

<%= render "logins/providers", login: login %>
