<%= render "logins/header", heading: "Enter your password", login: login %>

<%= render "logins/identified", login: login %>

<%= render "logins/warnings", login: login %>

<%= form_with url: login_path, method: :post, id: "first-factor", class: "flex flex-col gap-4" do |form| %>
  <%= form.hidden_field :event, value: "password" %>

  <label class="flex flex-col gap-1.5">
    <span class="text-sm font-medium">Password</span>
    <%= form.password_field :password, autocomplete: "current-password",
          class: "input input-bordered w-full" %>
  </label>

  <button type="submit" class="btn btn-primary w-full">Sign in</button>
<% end %>
