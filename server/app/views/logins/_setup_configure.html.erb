<% setup = login.state("setup").as_json["setup"] %>
<% tenant = Current.tenant&.name.to_s %>
<% manager = login.actor&.identifier.to_s %>

<div class="setup flow">
  <div class="auth-pair">
    <span class="auth-mark auth-mark-client" aria-hidden="true"><%= manager.first&.upcase %></span>
    <span class="auth-wire"></span>
    <span class="auth-mark" aria-hidden="true"><%= tenant.first&.upcase %></span>
  </div>

  <%= render "logins/head", cap: t(".cap"), title: t(".title"), name: tenant %>

  <%= render "logins/setup_steps", at: 3 %>

  <%= form_with url: login_path, method: :post, id: "setup-configure", class: "flow" do |form| %>
    <%= hidden_field_tag :rid, login.rid %>

    <div class="slab">
      <label class="ledger-row ledger-step ledger-step-4<%= " ledger-step-done" if setup["called"].present? %>">
        <span class="ledger-label"><%= t(".called") %></span>
        <%= form.text_field :called, value: setup["called"], class: "control" %>
        <span class="field-hint"><%= t(".called_hint") %></span>
      </label>

      <div class="ledger-row">
        <span class="ledger-label"><%= t(".origin") %></span>
        <span class="ledger-value aside-mono"><%= Current.origin %></span>
      </div>
    </div>

    <button type="submit" name="event" value="setup-configure" class="action">
      <%= t(".submit") %>
    </button>
  <% end %>

  <p class="aside">
    <%= t(".once") %>
    <%= link_to t(".docs"), Rails.configuration.masks.docs_url,
          class: "textlink", rel: "noopener", target: "_blank" %>
  </p>
</div>
