<% configure = login.state("configure").as_json["configure"] %>

<div class="setup flow">
  <%= render "logins/signup_head", login: login, at: 3, mark: login.actor&.identifier.to_s %>

  <%= form_with url: login_path, method: :post, id: "setup-configure", class: "flow" do |form| %>
    <%= hidden_field_tag :rid, login.rid %>

    <div class="slab">
      <label class="ledger-row ledger-step<%= " ledger-step-done" if configure["called"].present? %>">
        <span class="ledger-label"><%= t(".called") %></span>
        <%= form.text_field :called, value: configure["called"], class: "control" %>
        <span class="field-hint"><%= t(".called_hint") %></span>
      </label>

      <div class="ledger-row">
        <span class="ledger-label"><%= t("logins.signing_up.origin") %></span>
        <span class="ledger-value aside-mono"><%= Current.origin %></span>
      </div>
    </div>

    <button type="submit" name="event" value="setup-configure" class="action">
      <%= t(".submit") %>
    </button>
  <% end %>

  <p class="aside">
    <%= t("logins.signing_up.once") %>
    <%= link_to t("logins.signing_up.docs"), Rails.configuration.masks.docs_url,
          class: "textlink", rel: "noopener", target: "_blank" %>
  </p>
</div>
