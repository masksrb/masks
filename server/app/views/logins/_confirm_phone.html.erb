<% confirmation = login.as_json["confirmation"] %>

<%= render "logins/confirm_head", login: login, title: t(".title"), lede: t(".lede", phone: confirmation["phone"]) %>

<% if confirmation["texts"] %>
  <%= form_with url: login_path, method: :post, id: "confirm-phone", class: "flow" do |form| %>
    <%= hidden_field_tag :rid, login.rid %>
    <%= form.hidden_field :event, value: "confirm:phone" %>

    <label class="field">
      <span class="field-label"><%= t(".code") %></span>
      <%= form.text_field :code, inputmode: "numeric", pattern: "[0-9]*", autocomplete: "one-time-code",
            maxlength: 6, spellcheck: "false", class: "control control-code" %>
    </label>

    <button type="submit" class="action"><%= t("logins.shared.continue") %></button>
  <% end %>

  <%= render "logins/resend", login: login %>
<% else %>
  <p class="note note-warn" role="alert"><%= t(".no_texts") %></p>
<% end %>

<%= form_with url: login_path, method: :post, class: "flow" do |form| %>
  <%= hidden_field_tag :rid, login.rid %>
  <%= form.hidden_field :event, value: "confirm:change-phone" %>
  <button type="submit" class="action action-plain"><%= t(".change_phone") %></button>
<% end %>
