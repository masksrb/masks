<% reset = login.state("password-reset").reset %>

<%= render "logins/header", heading: "Set a new password", login: login %>

<p class="prompt-lede">
  Setting a password here signs <%= reset.actor.nickname %> out everywhere else.
</p>

<%= form_with url: login_path, method: :post, id: "reset-password", class: "flow" do |form| %>
  <%= hidden_field_tag :rid, login.rid %>
  <%= form.hidden_field :event, value: "reset-password" %>

  <label class="field">
    <span class="field-label">Username</span>
    <input type="text" value="<%= reset.actor.nickname %>" readonly
           autocomplete="username" class="control" />
  </label>

  <label class="field">
    <span class="field-label">New password</span>
    <%= form.password_field :password, autocomplete: "new-password", class: "control" %>
    <span class="field-hint">
      At least <%= LoginStates::PasswordReset::MINIMUM_PASSWORD %> characters.
    </span>
  </label>

  <button type="submit" class="action">Set the password</button>
<% end %>
