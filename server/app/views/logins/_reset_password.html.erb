<% reset = login.state("password-reset").reset %>

<%= render "logins/header", heading: "Choose a new password", login: login %>

<p class="text-sm opacity-75">
  Setting a password here signs <%= reset.actor.nickname %> out everywhere else.
</p>

<%= render "logins/warnings", login: login %>

<%= form_with url: login_path, method: :post, id: "reset-password", class: "flex flex-col gap-4" do |form| %>
  <%= hidden_field_tag :rid, login.rid %>
  <%= form.hidden_field :event, value: "reset-password" %>

  <label class="flex flex-col gap-1.5">
    <span class="text-sm font-medium">Username</span>
    <input type="text" value="<%= reset.actor.nickname %>" readonly
           autocomplete="username" class="input input-bordered w-full" />
  </label>

  <label class="flex flex-col gap-1.5">
    <span class="text-sm font-medium">New password</span>
    <%= form.password_field :password, autocomplete: "new-password",
          class: "input input-bordered w-full" %>
    <span class="text-xs opacity-75">
      At least <%= LoginStates::PasswordReset::MINIMUM_PASSWORD %> characters.
    </span>
  </label>

  <button type="submit" class="btn btn-primary w-full">Set the password</button>
<% end %>
