<nav class="tabset" aria-label="<%= t("logins.shared.tabs") %>">
  <% steps.each_with_index do |step, index| %>
    <% place = index + 1 %>
    <span class="tabset-tab<%= " tabset-done" if place < at %><%= " tabset-now" if place == at %>"
          <%= tag.attributes(aria: { current: place == at ? "step" : nil }) %>><%= t("logins.shared.tab_#{step}") %></span>
  <% end %>
</nav>
