<% signup = login.state("signup").as_json["signup"] %>
<% asks = signup["asks"] %>
<% value = ->(field) { login.updates[field].presence || signup[field].to_s } %>
<% done = ->(field) { " ledger-step-done" if value.(field).present? } %>

<div class="setup flow">
  <%= render "logins/signup_head", first_run: signup["firstRun"], steps: signup["steps"], at: 1,
                                   mark: value.("nickname").presence || value.("email") %>

  <%= form_with url: login_path, method: :post, id: "signup", class: "flow" do |form| %>
    <%= hidden_field_tag :rid, login.rid %>

    <div class="slab">
      <% if signup["token"] %>
        <label class="ledger-row ledger-step">
          <span class="ledger-label"><%= t("logins.shared.token") %></span>
          <%= form.password_field :token, autocomplete: "off", class: "control" %>
          <span class="field-hint"><%= t("logins.shared.token_hint") %></span>
        </label>
      <% end %>

      <% if asks["nickname"] != "off" %>
        <label class="ledger-row ledger-step<%= done.("nickname") %>">
          <span class="ledger-label"><%= t("logins.shared.nickname") %></span>
          <%= form.text_field :nickname, value: value.("nickname"),
                autocomplete: "username", autocapitalize: "none", autocorrect: "off",
                spellcheck: "false", class: "control" %>
        </label>
      <% end %>

      <% if asks["email"] != "off" %>
        <label class="ledger-row ledger-step<%= done.("email") %>">
          <span class="ledger-label"><%= t("logins.shared.email") %></span>
          <%= form.email_field :email, value: value.("email"), autocomplete: "email", class: "control" %>
        </label>
      <% end %>

      <% if asks["phone"] != "off" %>
        <label class="ledger-row ledger-step<%= done.("phone") %>">
          <span class="ledger-label"><%= t("logins.shared.phone") %></span>
          <%= form.telephone_field :phone, value: value.("phone"), autocomplete: "tel",
                placeholder: "+15551234567", class: "control" %>
        </label>
      <% end %>

      <label class="ledger-row ledger-step<%= done.("name") %>">
        <span class="ledger-label"><%= t("logins.shared.name") %></span>
        <%= form.text_field :name, value: value.("name"), autocomplete: "name", class: "control" %>
      </label>

      <% if signup["firstRun"] %>
        <div class="ledger-row">
          <span class="ledger-label"><%= t("logins.shared.origin") %></span>
          <span class="ledger-value aside-mono"><%= Current.origin %></span>
        </div>
      <% end %>
    </div>

    <button type="submit" name="event" value="signup" class="action">
      <%= t("logins.shared.continue") %>
    </button>
  <% end %>

  <% if signup["firstRun"] %>
    <p class="aside">
      <%= t("logins.shared.once") %>
      <%= link_to t("logins.shared.docs"), Rails.configuration.masks.docs_url,
            class: "textlink", rel: "noopener", target: "_blank" %>
    </p>
  <% else %>
    <%= form_with url: login_path, method: :delete, class: "aside" do %>
      <%= hidden_field_tag :rid, login.rid %>
      <%= t("logins.shared.have_account") %>
      <button type="submit" class="textlink"><%= t("logins.shared.sign_in_instead") %></button>
    <% end %>
  <% end %>
</div>
