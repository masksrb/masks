<% signup = login.state("signup").as_json["signup"] %>
<% rows = %w[name nickname email phone].filter_map { |field| [ field, signup[field] ] if signup[field].present? } %>

<div class="setup flow">
  <%= render "logins/signup_head", login: login, at: 2,
                                   mark: signup["nickname"].presence || signup["email"] %>

  <%= form_with url: login_path, method: :post, id: "signup-credentials", class: "flow" do |form| %>
    <%= hidden_field_tag :rid, login.rid %>

    <div class="slab">
      <% rows.each do |field, value| %>
        <div class="ledger-row ledger-row-aside">
          <span class="ledger-label"><%= t("logins.shared.#{field}") %></span>
          <span class="ledger-value"><%= value %></span>
          <button type="submit" name="event" value="signup-edit" class="textlink ledger-aside">
            <%= t("logins.signing_up.edit") %>
          </button>
        </div>
      <% end %>

      <% if signup.dig("credentials", "password") %>
        <label class="ledger-row ledger-step">
          <span class="ledger-label"><%= t("logins.shared.password") %></span>
          <%= form.password_field :password, autocomplete: "new-password", class: "control" %>
          <%= render "logins/hint", login: login, field: "password",
                                    hint: t("logins.signing_up.password_hint", minimum: signup["minimum"]) %>
        </label>

        <label class="ledger-row ledger-step">
          <span class="ledger-label"><%= t("logins.signing_up.confirm") %></span>
          <%= form.password_field :password_confirmation, autocomplete: "new-password", class: "control" %>
          <%= render "logins/hint", login: login, field: "password_confirmation" %>
        </label>
      <% end %>
    </div>

    <% if signup.dig("credentials", "password") %>
      <button type="submit" name="event" value="signup" class="action">
        <%= login.journey["firstRun"] ? t("logins.signing_up.submit_first_run") : t("logins.signing_up.submit_signup") %>
      </button>
    <% else %>
      <p class="note note-warn" role="alert"><%= t("logins.signup_credentials.no_passkeys") %></p>
    <% end %>
  <% end %>

  <% if login.journey["firstRun"] %>
    <p class="aside">
      <%= t("logins.signing_up.once") %>
      <%= link_to t("logins.signing_up.docs"), Rails.configuration.masks.docs_url,
            class: "textlink", rel: "noopener", target: "_blank" %>
    </p>
  <% end %>
</div>
