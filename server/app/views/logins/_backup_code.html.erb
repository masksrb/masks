<div class="prompt-head">
  <h1 class="prompt-title">Use a backup code</h1>
</div>

<%= render "logins/identified", login: login %>

<%= form_with url: login_path, method: :post, id: "backup-code", class: "flow" do |form| %>
  <%= hidden_field_tag :rid, login.rid %>
  <%= form.hidden_field :event, value: "backup" %>

  <label class="field">
    <span class="field-label">Backup code</span>
    <%= form.text_field :backup_code, autocomplete: "one-time-code",
          spellcheck: "false", autocapitalize: "off", class: "control control-mono" %>
    <span class="field-hint">Each one works once.</span>
  </label>

  <button type="submit" class="action">Continue</button>
<% end %>

<%= form_with url: login_path, method: :post, id: "use-authenticator", class: "flow" do |form| %>
  <%= hidden_field_tag :rid, login.rid %>
  <%= form.hidden_field :event, value: "use-authenticator" %>
  <button type="submit" class="action action-plain">Use your authenticator</button>
<% end %>
