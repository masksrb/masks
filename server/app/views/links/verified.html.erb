<% content_for :title, "Address confirmed" %>

<div class="flex flex-col gap-4">
  <h1 class="text-2xl font-bold">Address confirmed</h1>

  <p class="text-sm opacity-75">
    <%= @actor.email %> is confirmed for <%= @actor.nickname %>. Applications you
    sign in to are now told the address has been checked.
  </p>

  <p><%= link_to "Go to your account", root_path, class: "link text-sm" %></p>
</div>
