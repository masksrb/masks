<% content_for :title, "This #{@noun} is no longer valid" %>

<div class="flex flex-col gap-4">
  <h1 class="text-2xl font-bold">This <%= @noun %> is no longer valid</h1>

  <p class="text-sm opacity-75">
    Links like this one work once and expire. This one has already been used, or
    it has been open long enough to lapse, or a newer one replaced it.
  </p>

  <p class="text-sm opacity-75">
    Nothing has changed on the account. Ask for another.
  </p>

  <p><%= link_to "Go to sign in", login_path, class: "link text-sm" %></p>
</div>
