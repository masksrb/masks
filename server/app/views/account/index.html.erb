<% content_for :title, Current.tenant&.name %>

<% content_for :surface, "place" if @actor %>

<% content_for :scripts do %>
  <%= vite_javascript_tag "account" %>
<% end %>

<% if @actor %>
  <div id="account" class="place">
    <%= render "account/head", actor: @actor %>

    <%= render "account/needs", actor: @actor, passkeys: @passkeys, devices: @devices %>

    <%= render "account/signing_in", actor: @actor, passkeys: @passkeys %>

    <%= render "account/devices", devices: @devices, trusted: @trusted, live: @live %>

    <%= render "account/apps", consents: @consents, connections: @connections,
          providers: @providers %>

    <%= render "account/info", actor: @actor %>

    <%= render "account/activity", events: @events %>
  </div>
<% else %>
  <div class="prompt-head">
    <h1 class="prompt-title"><%= t(".signed_out.title") %></h1>
  </div>

  <%= link_to t(".signed_out.sign_in"), login_path, class: "action" %>
<% end %>
