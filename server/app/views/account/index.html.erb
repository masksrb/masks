<% content_for :title, Current.tenant&.name %>

<% content_for :surface, "place" if @actor %>

<% content_for :scripts do %>
  <%= vite_javascript_tag "account" %>
<% end %>

<% if @actor %>
  <div id="account" class="place">
    <aside class="place-rail">
      <div class="place-id">
        <%= avatar_tag @actor, size: 64 %>
        <span class="place-who"><%= @actor.nickname %></span>
        <% if Current.tenant&.name.present? %>
          <span class="auth-tenant"><%= Current.tenant.name %></span>
        <% end %>
      </div>

      <ul class="place-nav">
        <li><a href="#avatar"><%= t(".nav.avatar") %></a></li>
        <li><a href="#applications"><%= t(".nav.applications") %></a></li>
        <li><a href="#connections"><%= t(".nav.connections") %></a></li>
        <li><a href="#passkeys"><%= t(".nav.passkeys") %></a></li>
        <li><a href="#devices"><%= t(".nav.devices") %></a></li>
        <li><a href="#email"><%= t(".nav.email") %></a></li>
        <li><a href="#password"><%= t(".nav.password") %></a></li>
        <li><a href="#activity"><%= t(".nav.activity") %></a></li>
      </ul>

      <div><%= link_to t(".sign_out"), logout_path, class: "textlink" %></div>
    </aside>

    <div class="place-body">
      <section id="avatar" class="place-section">
        <h2><%= t(".avatar.heading") %></h2>

        <p class="aside"><%= t(".avatar.lede") %></p>

        <ul class="avatar-set">
          <% Avatars::STYLES.each do |style| %>
            <li class="avatar-choice">
              <% if style == Avatars::PHOTO && !Avatars.held?(@actor) %>
                <span class="avatar avatar-empty" aria-hidden="true"></span>
              <% else %>
                <%= avatar_tag @actor, style: style, size: 96 %>
              <% end %>
              <span class="avatar-name"><%= style %></span>
            </li>
          <% end %>
        </ul>

        <%= form_with url: account_avatar_path, method: :post, class: "flow-tight",
              html: { multipart: true } do |form| %>
          <label class="field">
            <span class="field-label"><%= t(".avatar.photo") %></span>
            <%= form.file_field :avatar, accept: "image/png,image/jpeg,image/webp,image/gif",
                  required: true, class: "control control-sm" %>
            <span class="field-hint"><%= t(".avatar.hint") %></span>
          </label>

          <button type="submit" class="action action-sm"><%= t(".avatar.upload") %></button>
        <% end %>

        <% if Avatars.photo(@actor) %>
          <%= button_to t(".avatar.remove"), account_avatar_path, method: :delete,
                class: "action action-quiet action-sm",
                form: { data: { turbo_confirm: t(".avatar.confirm_remove") } } %>
        <% end %>
      </section>

      <section id="applications" class="place-section">
        <h2><%= t(".applications.heading") %></h2>

        <% if @consents.any? %>
          <ul class="chip-list">
            <% @consents.each do |consent| %>
              <li class="chip chip-stack">
                <span class="chip-line">
                  <span class="chip-name"><%= consent.client.name %></span>
                  <span class="chip-meta">
                    <%= button_to t(".applications.revoke"), account_consent_path(consent),
                          method: :delete, class: "textlink", form_class: "chip-action",
                          form: { data: { turbo_confirm: t(".applications.confirm_revoke",
                                                            client: consent.client.name) } } %>
                  </span>
                </span>

                <span class="chip-key"><%= consent.scopes %></span>
              </li>
            <% end %>
          </ul>
        <% else %>
          <p class="aside"><%= t(".none_yet") %></p>
        <% end %>
      </section>

      <section id="connections" class="place-section">
        <h2><%= t(".connections.heading") %></h2>

        <p class="aside"><%= t(".connections.lede") %></p>

        <% if @connections.any? %>
          <ul class="chip-list">
            <% @connections.each do |connection| %>
              <li class="chip chip-stack">
                <span class="chip-line">
                  <span class="chip-name">
                    <span><%= connection.provider.name %></span>
                    <% if connection.signed_in_at %>
                      <span class="tag"><%= t(".connections.signs_you_in") %></span>
                    <% end %>
                  </span>
                  <span class="chip-meta">
                    <%= button_to t(".connections.disconnect"), account_connection_path(connection.uuid),
                          method: :delete, class: "textlink", form_class: "chip-action",
                          form: { data: { turbo_confirm: t(".connections.confirm_disconnect",
                                                            provider: connection.provider.name) } } %>
                  </span>
                </span>

                <span class="chip-meta">
                  <span><%= connection.label || connection.email || connection.subject %></span>
                </span>
              </li>
            <% end %>
          </ul>
        <% else %>
          <p class="aside"><%= t(".none_yet") %></p>
        <% end %>

        <% if @providers.any? %>
          <div class="action-row">
            <% @providers.each do |provider| %>
              <%= button_to t(".connections.connect", provider: provider.name),
                    connect_path(provider.key), class: "action action-quiet action-sm" %>
            <% end %>
          </div>
        <% end %>
      </section>

      <section id="passkeys" data-passkeys class="place-section">
        <h2><%= t(".passkeys.heading") %></h2>

        <% if @passkeys.any? %>
          <ul class="chip-list">
            <% @passkeys.each do |passkey| %>
              <li class="chip chip-stack">
                <span class="chip-line">
                  <span class="chip-name">
                    <% if passkey.icon %>
                      <img src="<%= passkey.icon %>" alt="" width="16" height="16" />
                    <% end %>
                    <span><%= passkey.label %></span>
                    <% if passkey.authenticator&.certified? %>
                      <span class="tag"><%= t(".passkeys.certified") %></span>
                    <% end %>
                  </span>
                  <span class="chip-meta">
                    <span>
                      <%= passkey.last_used_at ?
                            t(".passkeys.used", age: time_ago_in_words(passkey.last_used_at)) :
                            t(".passkeys.never_used") %>
                    </span>
                    <%= button_to t(".passkeys.remove"), passkey_path(passkey), method: :delete,
                          class: "textlink", form_class: "chip-action",
                          form: { data: { turbo_confirm: t(".passkeys.confirm_remove") } } %>
                  </span>
                </span>

                <% if passkey.compromised? %>
                  <span class="aside aside-bad">
                    <%= t(".passkeys.compromised", report: passkey.compromise.downcase.tr("_", " ")) %>
                  </span>
                <% end %>
              </li>
            <% end %>
          </ul>
        <% else %>
          <p class="aside"><%= t(".none_yet") %></p>

          <details class="disclosure">
            <summary class="textlink"><%= t(".passkeys.what_is_one") %></summary>
            <p class="aside"><%= t(".passkeys.explained") %></p>
          </details>
        <% end %>

        <%= form_with url: passkeys_path, method: :post, id: "add-passkey",
              hidden: true, data: { challenge: passkey_challenge_path },
              class: "flow-tight" do |form| %>
          <%= form.hidden_field :credential, id: "passkey-credential" %>

          <label class="field">
            <span class="field-label"><%= t(".passkeys.name") %></span>
            <%= form.text_field :name, id: "passkey-name",
                  placeholder: t(".passkeys.name_placeholder"), class: "control control-sm" %>
          </label>

          <button type="button" id="add-passkey-button" class="action action-quiet action-sm">
            <%= t(".passkeys.add") %>
          </button>
        <% end %>

        <p id="passkey-unusable" hidden class="aside aside-bad"></p>
      </section>

      <section id="devices" class="place-section">
        <h2><%= t(".devices.heading") %></h2>

        <% if @devices.any? %>
          <ul class="chip-list">
            <% @devices.each do |device| %>
              <li class="chip chip-stack">
                <span class="chip-line">
                  <span class="chip-name">
                    <span><%= device.label %></span>
                    <% if device == current_device %>
                      <span class="tag tag-live"><%= t(".devices.this_device") %></span>
                    <% end %>
                    <% if @trusted.include?(device.id) %>
                      <span class="tag"><%= t(".devices.skips_code") %></span>
                    <% end %>
                    <% if device.blocked? %>
                      <span class="tag tag-bad"><%= t(".devices.blocked") %></span>
                    <% end %>
                    <% unless @live.include?(device.id) %>
                      <span class="tag"><%= t(".devices.signed_out") %></span>
                    <% end %>
                  </span>
                  <span class="chip-meta">
                    <span><%= t(".devices.seen", age: time_ago_in_words(device.last_seen_at)) %></span>
                    <% if @live.include?(device.id) %>
                      <%= button_to t(".devices.sign_out"), device_path(device), method: :delete,
                            class: "textlink", form_class: "chip-action" %>
                    <% end %>
                  </span>
                </span>

                <span class="chip-meta">
                  <span class="aside-mono"><%= device.ip_address || "—" %></span>
                  <span><%= device.category %></span>
                </span>

                <%= form_with url: device_path(device), method: :patch, class: "action-row" do |form| %>
                  <%= form.text_field :name, value: device.name, placeholder: device.label,
                        class: "control control-sm action-grow" %>
                  <button type="submit" class="action action-quiet action-sm"><%= t(".devices.rename") %></button>
                <% end %>
              </li>
            <% end %>
          </ul>
        <% else %>
          <p class="aside"><%= t(".none_yet") %></p>
        <% end %>
      </section>

      <section id="email" class="place-section">
        <h2><%= t(".email.heading") %></h2>

        <% if @actor.email.blank? %>
          <p class="aside"><%= t(".email.none_set") %></p>
        <% elsif @actor.email_verified_at.present? %>
          <p class="aside"><%= t(".email.confirmed", email: @actor.email) %></p>
        <% else %>
          <p class="aside"><%= t(".email.unconfirmed", email: @actor.email) %></p>

          <%= button_to t(".email.send_link"), account_verification_path,
                class: "action action-quiet action-sm" %>
        <% end %>
      </section>

      <section id="password" class="place-section">
        <h2><%= t(".password.heading") %></h2>

        <%= form_with url: account_password_path, method: :patch, id: "change-password",
              class: "flow-tight" do |form| %>
          <label class="field">
            <span class="field-label"><%= t(".password.current") %></span>
            <%= form.password_field :current_password, autocomplete: "current-password",
                  class: "control" %>
          </label>

          <label class="field">
            <span class="field-label"><%= t(".password.new") %></span>
            <%= form.password_field :password, autocomplete: "new-password", class: "control" %>
            <span class="field-hint">
              <%= t(".password.hint", minimum: PasswordsController::MINIMUM) %>
            </span>
          </label>

          <button type="submit" class="action action-sm"><%= t(".password.submit") %></button>
        <% end %>
      </section>

      <section id="activity" class="place-section">
        <h2><%= t(".activity.heading") %></h2>

        <p class="aside"><%= t(".activity.lede") %></p>

        <% if @events.any? %>
          <ul class="chip-list">
            <% @events.each do |event| %>
              <li class="chip chip-stack">
                <span class="chip-line">
                  <span class="chip-name">
                    <span><%= event_said(event) %></span>
                    <% if event_grave?(event) %>
                      <span class="tag tag-bad"><%= t(".activity.check_this") %></span>
                    <% end %>
                  </span>
                  <span class="chip-meta">
                    <span title="<%= l(event.created_at, format: :long) %>">
                      <%= t(".activity.ago", age: time_ago_in_words(event.created_at)) %>
                    </span>
                  </span>
                </span>

                <% if event_where(event).present? %>
                  <span class="chip-meta">
                    <span class="aside-mono"><%= event_where(event) %></span>
                  </span>
                <% end %>
              </li>
            <% end %>
          </ul>
        <% else %>
          <p class="aside"><%= t(".none_yet") %></p>
        <% end %>
      </section>
    </div>
  </div>
<% else %>
  <div class="prompt-head">
    <h1 class="prompt-title"><%= t(".signed_out.title") %></h1>
  </div>

  <%= link_to t(".signed_out.sign_in"), login_path, class: "action" %>
<% end %>
