<% content_for :title, Current.tenant&.name %>

<div class="flex flex-col gap-4">
  <% if @actor %>
    <h1 class="text-2xl font-bold">Signed in as <%= @actor.nickname %></h1>

    <% if @consents.any? %>
      <h2 class="text-xs font-bold uppercase opacity-75">Applications you have authorized</h2>
      <ul class="flex flex-col gap-2">
        <% @consents.each do |consent| %>
          <li class="flex items-baseline justify-between gap-3 rounded-lg border border-base-content/15 bg-base-200 px-3 py-2">
            <span class="text-sm"><%= consent.client.name %></span>
            <span class="font-mono text-xs opacity-75"><%= consent.scopes %></span>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p class="text-sm opacity-75">You have not authorized any applications yet.</p>
    <% end %>

    <p><%= link_to "Sign out", logout_path, class: "link text-sm" %></p>
  <% else %>
    <h1 class="text-2xl font-bold"><%= Current.tenant.name %></h1>
    <p><%= link_to "Log in", login_path, class: "link text-sm" %></p>
  <% end %>
</div>
