<% content_for :title, Current.tenant&.name %>

<% content_for :surface, "place" if @actor %>
<% content_for :surface, "ceremony" if @first_run %>

<% content_for :scripts do %>
  <%= vite_javascript_tag "account" %>
<% end %>

<% if @actor %>
  <div id="account" class="place">
    <aside class="place-rail">
      <div class="place-id">
        <%= avatar_tag @actor, size: 64 %>
        <span class="place-who"><%= @actor.nickname %></span>
        <% if Current.tenant&.name.present? %>
          <span class="auth-tenant"><%= Current.tenant.name %></span>
        <% end %>
      </div>

      <ul class="place-nav">
        <li><a href="#avatar">Avatar</a></li>
        <li><a href="#applications">Applications</a></li>
        <li><a href="#passkeys">Passkeys</a></li>
        <li><a href="#devices">Devices</a></li>
        <li><a href="#email">Email</a></li>
        <li><a href="#password">Password</a></li>
      </ul>

      <div><%= link_to "Sign out", logout_path, class: "textlink" %></div>
    </aside>

    <div class="place-body">
      <section id="avatar" class="place-section">
        <h2>Avatar</h2>

        <p class="aside">
          All three are always available to an application that asks. A photo is yours to
          upload; the other two are drawn from your account and cannot be removed.
        </p>

        <ul class="avatar-set">
          <% Avatars::STYLES.each do |style| %>
            <li class="avatar-choice">
              <% if style == Avatars::PHOTO && !Avatars.held?(@actor) %>
                <span class="avatar avatar-empty" aria-hidden="true"></span>
              <% else %>
                <%= avatar_tag @actor, style: style, size: 96 %>
              <% end %>
              <span class="avatar-name"><%= style %></span>
            </li>
          <% end %>
        </ul>

        <%= form_with url: account_avatar_path, method: :post, class: "flow-tight",
              html: { multipart: true } do |form| %>
          <label class="field">
            <span class="field-label">Photo</span>
            <%= form.file_field :avatar, accept: "image/png,image/jpeg,image/webp,image/gif",
                  required: true, class: "control control-sm" %>
            <span class="field-hint">
              Cropped to a square and re-encoded, so nothing of the original file survives.
            </span>
          </label>

          <button type="submit" class="action action-sm">Upload</button>
        <% end %>

        <% if Avatars.photo(@actor) %>
          <%= button_to "Remove photo", account_avatar_path, method: :delete,
                class: "action action-quiet action-sm",
                form: { data: { turbo_confirm: "Remove your photo?" } } %>
        <% end %>
      </section>

      <section id="applications" class="place-section">
        <h2>Applications</h2>

        <% if @consents.any? %>
          <ul class="chip-list">
            <% @consents.each do |consent| %>
              <li class="chip">
                <span><%= consent.client.name %></span>
                <span class="chip-key"><%= consent.scopes %></span>
              </li>
            <% end %>
          </ul>
        <% else %>
          <p class="aside">None yet.</p>
        <% end %>
      </section>

      <section id="passkeys" data-passkeys class="place-section">
        <h2>Passkeys</h2>

        <% if @passkeys.any? %>
          <ul class="chip-list">
            <% @passkeys.each do |passkey| %>
              <li class="chip chip-stack">
                <span class="chip-line">
                  <span class="chip-name">
                    <% if passkey.icon %>
                      <img src="<%= passkey.icon %>" alt="" width="16" height="16" />
                    <% end %>
                    <span><%= passkey.label %></span>
                    <% if passkey.authenticator&.certified? %>
                      <span class="tag">certified</span>
                    <% end %>
                  </span>
                  <span class="chip-meta">
                    <span>
                      <%= passkey.last_used_at ? "used #{time_ago_in_words(passkey.last_used_at)} ago" : "never used" %>
                    </span>
                    <%= button_to "Remove", passkey_path(passkey), method: :delete,
                          class: "textlink", form_class: "chip-action",
                          form: { data: { turbo_confirm: "Remove this passkey?" } } %>
                  </span>
                </span>

                <% if passkey.compromised? %>
                  <span class="aside aside-bad">
                    The FIDO Alliance reports a compromise for this model
                    (<%= passkey.compromise.downcase.tr("_", " ") %>). Replace it.
                  </span>
                <% end %>
              </li>
            <% end %>
          </ul>
        <% else %>
          <p class="aside">None yet.</p>

          <details class="disclosure">
            <summary class="textlink">What is a passkey?</summary>
            <p class="aside">
              It signs you in with the fingerprint, face or PIN your device already
              uses, and counts as both factors on its own.
            </p>
          </details>
        <% end %>

        <%= form_with url: passkeys_path, method: :post, id: "add-passkey",
              hidden: true, data: { challenge: passkey_challenge_path },
              class: "flow-tight" do |form| %>
          <%= form.hidden_field :credential, id: "passkey-credential" %>

          <label class="field">
            <span class="field-label">Name</span>
            <%= form.text_field :name, id: "passkey-name", placeholder: "This laptop",
                  class: "control control-sm" %>
          </label>

          <button type="button" id="add-passkey-button" class="action action-quiet action-sm">
            Add a passkey
          </button>
        <% end %>

        <p id="passkey-unusable" hidden class="aside aside-bad"></p>
      </section>

      <section id="devices" class="place-section">
        <h2>Devices</h2>

        <% if @devices.any? %>
          <ul class="chip-list">
            <% @devices.each do |device| %>
              <li class="chip chip-stack">
                <span class="chip-line">
                  <span class="chip-name">
                    <span><%= device.label %></span>
                    <% if device == current_device %>
                      <span class="tag tag-live">this device</span>
                    <% end %>
                    <% if @trusted.include?(device.id) %>
                      <span class="tag">skips your code</span>
                    <% end %>
                    <% if device.blocked? %>
                      <span class="tag tag-bad">blocked</span>
                    <% end %>
                    <% unless @live.include?(device.id) %>
                      <span class="tag">signed out</span>
                    <% end %>
                  </span>
                  <span class="chip-meta">
                    <span>seen <%= time_ago_in_words(device.last_seen_at) %> ago</span>
                    <% if @live.include?(device.id) %>
                      <%= button_to "Sign out", device_path(device), method: :delete,
                            class: "textlink", form_class: "chip-action" %>
                    <% end %>
                  </span>
                </span>

                <span class="chip-meta">
                  <span class="aside-mono"><%= device.ip_address || "—" %></span>
                  <span><%= device.category %></span>
                </span>

                <%= form_with url: device_path(device), method: :patch, class: "action-row" do |form| %>
                  <%= form.text_field :name, value: device.name, placeholder: device.label,
                        class: "control control-sm action-grow" %>
                  <button type="submit" class="action action-quiet action-sm">Rename</button>
                <% end %>
              </li>
            <% end %>
          </ul>
        <% else %>
          <p class="aside">None yet.</p>
        <% end %>
      </section>

      <section id="email" class="place-section">
        <h2>Email</h2>

        <% if @actor.email.blank? %>
          <p class="aside">None set.</p>
        <% elsif @actor.email_verified_at.present? %>
          <p class="aside"><%= @actor.email %> — confirmed.</p>
        <% else %>
          <p class="aside"><%= @actor.email %> — unconfirmed.</p>

          <%= button_to "Send a link", account_verification_path,
                class: "action action-quiet action-sm" %>
        <% end %>
      </section>

      <section id="password" class="place-section">
        <h2>Password</h2>

        <%= form_with url: account_password_path, method: :patch, id: "change-password",
              class: "flow-tight" do |form| %>
          <label class="field">
            <span class="field-label">Current password</span>
            <%= form.password_field :current_password, autocomplete: "current-password",
                  class: "control" %>
          </label>

          <label class="field">
            <span class="field-label">New password</span>
            <%= form.password_field :password, autocomplete: "new-password", class: "control" %>
            <span class="field-hint">
              At least <%= PasswordsController::MINIMUM %> characters.
              Signs out every other session.
            </span>
          </label>

          <button type="submit" class="action action-sm">Change password</button>
        <% end %>
      </section>
    </div>
  </div>
<% elsif @first_run %>
  <div class="ceremony">
    <aside class="record">
      <span class="record-cap">This instance</span>

      <div class="rec-rows">
        <div class="rec-row">
          <span class="rec-key">tenant</span>
          <span class="rec-val rec-val-fixed"><%= Current.tenant&.name %></span>
        </div>
        <div class="rec-row">
          <span class="rec-key">owner</span>
          <span class="rec-val rec-val-pending">none yet</span>
        </div>
        <div class="rec-row">
          <span class="rec-key">console</span>
          <span class="rec-val <%= @connected ? "rec-val-fixed" : "rec-val-pending" %>">
            <%= @connected ? "connected" : "not connected" %>
          </span>
        </div>
        <div class="rec-row">
          <span class="rec-key">keys</span>
          <span class="rec-val rec-val-fixed">generated</span>
        </div>
      </div>
    </aside>

    <div class="flow">
      <div class="prompt-head">
        <span class="record-cap">First run</span>
        <h1 class="prompt-title">Nobody owns this yet</h1>
        <p class="prompt-lede">
          The tenant is up and its signing keys exist. It has no accounts, so nothing can sign in
          until you make the first one.
        </p>
      </div>

      <%= link_to "Create the owner", login_path, class: "action" %>

      <%= link_to "Open the console", manage_path, class: "action action-quiet" %>

      <p class="aside">
        The owner comes first — the console signs you in against this tenant, so it needs an account
        to sign in as. Read the
        <%= link_to "documentation", Rails.configuration.masks.docs_url,
              class: "textlink", rel: "noopener" %> for what to do after that.
      </p>
    </div>
  </div>
<% else %>
  <div class="prompt-head">
    <h1 class="prompt-title">Your account</h1>
  </div>

  <%= link_to "Sign in", login_path, class: "action" %>
<% end %>
