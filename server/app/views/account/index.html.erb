<% content_for :title, Current.tenant&.name %>

<% content_for :scripts do %>
  <%= vite_javascript_tag "account" %>
<% end %>

<div class="flex flex-col gap-4">
  <% if @actor %>
    <h1 class="text-2xl font-bold">Signed in as <%= @actor.nickname %></h1>

    <% if @consents.any? %>
      <h2 class="text-xs font-bold uppercase opacity-75">Applications you have authorized</h2>
      <ul class="flex flex-col gap-2">
        <% @consents.each do |consent| %>
          <li class="flex items-baseline justify-between gap-3 rounded-lg border border-base-content/15 bg-base-200 px-3 py-2">
            <span class="text-sm"><%= consent.client.name %></span>
            <span class="font-mono text-xs opacity-75"><%= consent.scopes %></span>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p class="text-sm opacity-75">You have not authorized any applications yet.</p>
    <% end %>

    <h2 class="text-xs font-bold uppercase opacity-75">Passkeys</h2>

    <div data-passkeys class="flex flex-col gap-3">
      <% if @passkeys.any? %>
        <ul class="flex flex-col gap-2">
          <% @passkeys.each do |passkey| %>
            <li class="flex items-baseline justify-between gap-3 rounded-lg border border-base-content/15 bg-base-200 px-3 py-2">
              <span class="text-sm"><%= passkey.name %></span>
              <span class="flex items-baseline gap-3">
                <span class="text-xs opacity-75">
                  <%= passkey.last_used_at ? "used #{time_ago_in_words(passkey.last_used_at)} ago" : "never used" %>
                </span>
                <%= button_to "Remove", passkey_path(passkey), method: :delete,
                      class: "link text-xs", form: { data: { turbo_confirm: "Remove this passkey?" } } %>
              </span>
            </li>
          <% end %>
        </ul>
      <% else %>
        <p class="text-sm opacity-75">
          No passkeys yet. A passkey signs you in with the fingerprint, face or PIN
          your device already uses — and counts as both factors on its own.
        </p>
      <% end %>

      <%= form_with url: passkeys_path, method: :post, id: "add-passkey",
            hidden: true, class: "flex flex-wrap items-end gap-3" do |form| %>
        <%= form.hidden_field :credential, id: "passkey-credential" %>

        <label class="flex flex-col gap-1.5">
          <span class="text-sm font-medium">Name</span>
          <%= form.text_field :name, id: "passkey-name", placeholder: "This laptop",
                class: "input input-bordered" %>
        </label>

        <button type="button" id="add-passkey-button" class="btn btn-primary">Add a passkey</button>
      <% end %>

      <p id="passkey-unusable" hidden class="text-xs text-error"></p>
    </div>

    <h2 class="text-xs font-bold uppercase opacity-75">Email</h2>

    <% if @actor.email.blank? %>
      <p class="text-sm opacity-75">
        This account has no email address. Applications that require one will refuse it.
      </p>
    <% elsif @actor.email_verified_at.present? %>
      <p class="text-sm opacity-75">
        <%= @actor.email %> — confirmed.
      </p>
    <% else %>
      <p class="text-sm opacity-75">
        <%= @actor.email %> is not confirmed, so applications are told so and some will
        refuse it.
      </p>

      <%= button_to "Send a confirmation link", account_verification_path,
            class: "btn btn-sm self-start" %>
    <% end %>

    <h2 class="text-xs font-bold uppercase opacity-75">Password</h2>

    <%= form_with url: account_password_path, method: :patch, id: "change-password",
          class: "flex flex-col gap-3" do |form| %>
      <label class="flex flex-col gap-1.5">
        <span class="text-sm font-medium">Current password</span>
        <%= form.password_field :current_password, autocomplete: "current-password",
              class: "input input-bordered w-full" %>
      </label>

      <label class="flex flex-col gap-1.5">
        <span class="text-sm font-medium">New password</span>
        <%= form.password_field :password, autocomplete: "new-password",
              class: "input input-bordered w-full" %>
        <span class="text-xs opacity-75">
          At least <%= PasswordsController::MINIMUM %> characters. Changing it signs out
          every other session and stops every application from refreshing.
        </span>
      </label>

      <button type="submit" class="btn btn-primary self-start">Change password</button>
    <% end %>

    <p><%= link_to "Sign out", logout_path, class: "link text-sm" %></p>
  <% else %>
    <div class="flex flex-col gap-1">
      <h1 class="text-2xl font-bold"><%= Current.tenant.name %></h1>
      <p class="text-sm opacity-75">
        Sign in to manage your account and authorized applications.
      </p>
    </div>

    <%= link_to "Log in", login_path, class: "btn btn-primary w-full" %>
  <% end %>
</div>
