<div class="plaque">
  <div class="plaque-top">
    <% if Current.tenant&.name.present? %>
      <span class="auth-mark" aria-hidden="true"><%= Current.tenant.name.first.upcase %></span>
      <span class="auth-tenant"><%= Current.tenant.name %></span>
    <% end %>
  </div>

  <h1 class="plaque-title"><%= account_text("title") %></h1>

  <% if flash[:alert].present? || flash[:notice].present? %>
    <div class="plaque-notes"><%= render "application/flashes" %></div>
  <% end %>

  <div class="plaque-shot<%= ' plaque-shot-done' if flash[:avatar].present? %>">
    <%= form_with url: account_avatar_path, method: :post, id: "picture",
          html: { multipart: true } do |form| %>
      <label class="plaque-pick">
        <%= avatar_tag actor, size: 88, class: "avatar plaque-avatar" %>

        <%= form.file_field :avatar, id: "picture-file", class: "plaque-file",
              accept: "image/png,image/jpeg,image/webp,image/gif" %>

        <span class="plaque-file-label"><%= account_text("picture.change") %></span>
      </label>
    <% end %>

    <% if Avatars.photo(actor) %>
      <%= button_to account_avatar_path, method: :delete, class: "plaque-badge",
            form_class: "plaque-badge-form",
            form: { data: { turbo_confirm: account_text("picture.confirm_remove") } },
            aria: { label: account_text("picture.remove") },
            title: account_text("picture.remove") do %>
        <%= account_icon(:close) %>
      <% end %>
    <% end %>

    <% if flash[:avatar].present? %>
      <span class="plaque-done" aria-hidden="true"><%= account_icon(:check) %></span>
      <span class="plaque-file-label" role="status"><%= flash[:avatar] %></span>
    <% end %>
  </div>

  <p class="plaque-name"><%= actor.name.presence || actor.identifier %></p>

  <p class="plaque-sub"><%= actor.email.presence || actor.identifier %></p>

  <div class="plaque-pills">
    <% if actor.manages? %>
      <%= link_to manage_path, class: "pill pill-accent" do %>
        <%= account_icon(:manage) %>
        <span><%= account_text("manage") %></span>
      <% end %>
    <% end %>

    <%= button_to account_text("sign_out"), logout_path, class: "pill", form_class: "signout" %>
  </div>
</div>
