<div class="hero">
  <%= avatar_tag actor, size: 88, class: "avatar hero-avatar" %>

  <h1 class="hero-name"><%= actor.name.presence || actor.identifier %></h1>

  <p class="hero-sub"><%= actor.email.presence || actor.identifier %></p>

  <div class="hero-pills">
    <% if actor.manages? %>
      <%= link_to manage_path, class: "pill pill-accent" do %>
        <%= account_icon(:manage) %>
        <span><%= account_text("manage") %></span>
      <% end %>
    <% end %>

    <%= link_to account_text("sign_out"), logout_path, class: "pill" %>
  </div>
</div>
