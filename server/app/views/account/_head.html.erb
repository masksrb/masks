<div class="place-head">
  <%= avatar_tag actor, size: 80 %>

  <h1 class="place-title"><%= account_text("welcome", name: actor.name.presence || actor.identifier) %></h1>

  <p class="place-lede"><%= account_text("lede") %></p>

  <p class="place-who">
    <span><%= actor.identifier %></span>
    <%= link_to account_text("sign_out"), logout_path, class: "textlink" %>
  </p>

  <% if actor.manages? %>
    <%= link_to account_text("manage"), manage_path, class: "action action-quiet action-sm" %>
  <% end %>
</div>
