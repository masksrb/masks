<section class="group" id="devices">
  <h2><%= account_text("devices.heading") %></h2>

  <p class="aside"><%= account_text("devices.lede") %></p>

  <% if devices.any? %>
    <div class="rows">
      <% devices.each do |device| %>
        <details class="row">
          <summary>
            <span class="row-label"><%= device.label %></span>
            <span class="row-state <%= "row-state-bad" if device.blocked? %>">
              <% if device.blocked? %>
                <%= account_text("devices.state.blocked") %>
              <% elsif device == current_device %>
                <%= account_text("devices.state.here") %>
              <% elsif live.include?(device.id) %>
                <%= account_text("devices.state.signed_in") %>
              <% else %>
                <%= account_text("devices.state.signed_out") %>
              <% end %>
            </span>
            <span class="row-mark" aria-hidden="true"></span>
          </summary>

          <div class="row-body">
            <p class="aside">
              <%= account_text("devices.seen", age: time_ago_in_words(device.last_seen_at)) %>
              <% if device.ip_address.present? %>
                <%= account_text("devices.from", address: device.ip_address) %>
              <% end %>
              <% if trusted.include?(device.id) %>
                <%= account_text("devices.skips_code") %>
              <% end %>
            </p>

            <%= form_with url: device_path(device), method: :patch, class: "action-row" do |form| %>
              <%= form.text_field :name, value: device.name, placeholder: device.label,
                    class: "control control-sm action-grow" %>
              <button type="submit" class="action action-quiet action-sm">
                <%= account_text("devices.save_name") %>
              </button>
            <% end %>

            <% if live.include?(device.id) %>
              <div class="action-row">
                <%= button_to account_text("devices.sign_out"), device_path(device),
                      method: :delete, class: "action action-quiet action-sm" %>
              </div>
            <% end %>
          </div>
        </details>
      <% end %>
    </div>
  <% else %>
    <p class="aside"><%= account_text("devices.none") %></p>
  <% end %>
</section>
