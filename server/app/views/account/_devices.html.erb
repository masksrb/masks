<section id="devices" class="panel slab">
  <div class="panel-head">
    <h2 class="panel-title"><%= account_text("devices.heading") %></h2>
    <span class="panel-count"><%= devices.size %></span>
  </div>

  <% if devices.any? %>
    <ul class="chip-list">
      <% devices.each do |device| %>
        <li class="chip chip-stack">
          <span class="chip-line">
            <span class="chip-name">
              <span><%= device.label %></span>
              <% if device == current_device %>
                <span class="tag tag-live"><%= account_text("devices.this_device") %></span>
              <% end %>
              <% if trusted.include?(device.id) %>
                <span class="tag"><%= account_text("devices.skips_code") %></span>
              <% end %>
              <% if device.blocked? %>
                <span class="tag tag-bad"><%= account_text("devices.blocked") %></span>
              <% end %>
              <% unless live.include?(device.id) %>
                <span class="tag"><%= account_text("devices.signed_out") %></span>
              <% end %>
            </span>
            <span class="chip-meta">
              <span><%= account_text("devices.seen", age: time_ago_in_words(device.last_seen_at)) %></span>
              <% if live.include?(device.id) %>
                <%= button_to account_text("devices.sign_out"), device_path(device), method: :delete,
                      class: "textlink", form_class: "chip-action" %>
              <% end %>
            </span>
          </span>

          <span class="chip-meta">
            <span class="aside-mono"><%= device.ip_address || "—" %></span>
            <span><%= device.category %></span>
          </span>

          <details class="disclosure">
            <summary class="textlink"><%= account_text("devices.rename") %></summary>

            <%= form_with url: device_path(device), method: :patch, class: "action-row" do |form| %>
              <%= form.text_field :name, value: device.name, placeholder: device.label,
                    class: "control control-sm action-grow" %>
              <button type="submit" class="action action-quiet action-sm">
                <%= account_text("devices.save_name") %>
              </button>
            <% end %>
          </details>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p class="aside"><%= account_text("none_yet") %></p>
  <% end %>
</section>
