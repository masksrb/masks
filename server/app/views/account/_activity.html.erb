<section class="group" id="activity">
  <h2><%= account_text("activity.heading") %></h2>

  <div class="entries">
    <details class="entry">
      <summary>
        <span class="entry-icon"><%= account_icon(:activity) %></span>
        <span class="entry-label"><%= account_text("activity.entry") %></span>
        <span class="entry-state"><%= events.size %></span>
        <span class="entry-mark" aria-hidden="true"></span>
      </summary>

      <div class="entry-body">
        <p class="aside"><%= account_text("activity.lede") %></p>

        <% if events.any? %>
          <div class="items">
            <% events.each do |event| %>
              <div class="item">
                <span class="item-name">
                  <span><%= event_said(event) %></span>
                  <% if event_grave?(event) %>
                    <span class="tag tag-bad"><%= account_text("activity.check_this") %></span>
                  <% end %>
                </span>

                <span class="item-meta">
                  <span title="<%= l(event.created_at, format: :long) %>">
                    <%= account_text("activity.ago", age: time_ago_in_words(event.created_at)) %>
                  </span>
                  <% if event_where(event).present? %>
                    · <%= event_where(event) %>
                  <% end %>
                </span>
              </div>
            <% end %>
          </div>
        <% else %>
          <p class="aside"><%= account_text("none_yet") %></p>
        <% end %>
      </div>
    </details>
  </div>
</section>
