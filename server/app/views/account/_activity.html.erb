<section id="activity" class="panel panel-wide slab">
  <div class="panel-head">
    <h2 class="panel-title"><%= account_text("activity.heading") %></h2>
    <span class="panel-count"><%= events.size %></span>
  </div>

  <% if events.any? %>
    <ul class="chip-list">
      <% events.each do |event| %>
        <li class="chip chip-stack">
          <span class="chip-line">
            <span class="chip-name">
              <span><%= event_said(event) %></span>
              <% if event_grave?(event) %>
                <span class="tag tag-bad"><%= account_text("activity.check_this") %></span>
              <% end %>
            </span>
            <span class="chip-meta">
              <span title="<%= l(event.created_at, format: :long) %>">
                <%= account_text("activity.ago", age: time_ago_in_words(event.created_at)) %>
              </span>
            </span>
          </span>

          <% if event_where(event).present? %>
            <span class="chip-meta">
              <span class="aside-mono"><%= event_where(event) %></span>
            </span>
          <% end %>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p class="aside"><%= account_text("activity.lede") %></p>
  <% end %>
</section>
