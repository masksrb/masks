<section class="group" id="info">
  <h2><%= account_text("info.heading") %></h2>

  <div class="entries">
    <details class="entry" id="picture">
      <summary>
        <span class="entry-icon"><%= account_icon(:picture) %></span>
        <span class="entry-label"><%= account_text("picture.heading") %></span>
        <span class="entry-state">
          <%= Avatars.held?(actor) ? account_text("picture.state.set") :
                account_text("picture.state.none") %>
        </span>
        <span class="entry-mark" aria-hidden="true"></span>
      </summary>

      <div class="entry-body">
        <p class="aside"><%= account_text("picture.lede") %></p>

        <ul class="avatar-set">
          <% Avatars::STYLES.each do |style| %>
            <li class="avatar-choice">
              <% if style == Avatars::PHOTO && !Avatars.held?(actor) %>
                <span class="avatar avatar-empty" aria-hidden="true"></span>
              <% else %>
                <%= avatar_tag actor, style: style, size: 96 %>
              <% end %>
              <span class="avatar-name"><%= account_text("picture.styles.#{style}") %></span>
            </li>
          <% end %>
        </ul>

        <%= form_with url: account_avatar_path, method: :post, class: "flow-tight",
              html: { multipart: true } do |form| %>
          <label class="field">
            <span class="field-label"><%= account_text("picture.photo") %></span>
            <%= form.file_field :avatar, accept: "image/png,image/jpeg,image/webp,image/gif",
                  required: true, class: "control control-sm" %>
            <span class="field-hint"><%= account_text("picture.hint") %></span>
          </label>

          <div class="action-row">
            <button type="submit" class="action action-sm"><%= account_text("picture.upload") %></button>

            <% if Avatars.photo(actor) %>
              <%= button_to account_text("picture.remove"), account_avatar_path, method: :delete,
                    class: "action action-quiet action-sm",
                    form: { data: { turbo_confirm: account_text("picture.confirm_remove") } } %>
            <% end %>
          </div>
        <% end %>
      </div>
    </details>

    <details class="entry" id="notifications">
      <summary>
        <span class="entry-icon"><%= account_icon(:bell) %></span>
        <span class="entry-label"><%= account_text("notifications.heading") %></span>
        <span class="entry-state">
          <%= account_text("notifications.state", count: actor.muted_notifications.size) %>
        </span>
        <span class="entry-mark" aria-hidden="true"></span>
      </summary>

      <div class="entry-body">
        <p class="aside"><%= account_text("notifications.lede") %></p>

        <% unless Notifications.mailable?(actor) %>
          <p class="aside aside-bad"><%= account_text("notifications.silent") %></p>
        <% end %>

        <%= form_with url: account_notifications_path, method: :patch, class: "flow-tight" do |form| %>
          <%= hidden_field_tag "notifications[]", "" %>

          <% Notifications::GROUPS.each do |group, actions| %>
            <fieldset class="check-set">
              <legend class="field-label"><%= t("notifications.groups.#{group}") %></legend>

              <% actions.each do |action| %>
                <label class="check">
                  <%= check_box_tag "notifications[]", action, actor.notified?(action),
                        id: "notify-#{action.tr('.', '-')}" %>
                  <span><%= t("events.actions.#{action}") %></span>
                </label>
              <% end %>
            </fieldset>
          <% end %>

          <div class="action-row">
            <button type="submit" class="action action-sm"><%= account_text("notifications.submit") %></button>
          </div>
        <% end %>
      </div>
    </details>
  </div>
</section>
