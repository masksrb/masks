<% compromised = passkeys.select(&:compromised?) %>
<% blocked = devices.select(&:blocked?) %>
<% unconfirmed = actor.email.present? && actor.email_verified_at.nil? %>

<% if unconfirmed || compromised.any? || blocked.any? %>
  <section class="group" id="to-do">
    <h2><%= account_text("check.heading") %></h2>

    <div class="todos">
      <% if unconfirmed %>
        <div class="todo">
          <span class="todo-title"><%= account_text("check.email.title") %></span>
          <span class="todo-body"><%= account_text("check.email.body") %></span>
          <%= button_to account_text("email.send_link"), account_verification_path,
                class: "action action-quiet action-sm" %>
        </div>
      <% end %>

      <% if compromised.any? %>
        <div class="todo todo-bad">
          <span class="todo-title"><%= account_text("check.passkey.title") %></span>
          <span class="todo-body">
            <%= account_text("check.passkey.body", count: compromised.size) %>
          </span>
          <a class="action action-quiet action-sm" href="#passkeys">
            <%= account_text("check.look") %>
          </a>
        </div>
      <% end %>

      <% if blocked.any? %>
        <div class="todo todo-bad">
          <span class="todo-title"><%= account_text("check.device.title") %></span>
          <span class="todo-body">
            <%= account_text("check.device.body", count: blocked.size) %>
          </span>
          <a class="action action-quiet action-sm" href="#devices">
            <%= account_text("check.look") %>
          </a>
        </div>
      <% end %>
    </div>
  </section>
<% end %>
