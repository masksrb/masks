<% compromised = passkeys.select(&:compromised?) %>
<% blocked = devices.select(&:blocked?) %>
<% unconfirmed = actor.email.present? && actor.email_verified_at.nil? %>

<% if unconfirmed || compromised.any? || blocked.any? %>
  <section class="group" id="to-do">
    <h2><%= account_text("check.heading") %></h2>

    <div class="tiles">
      <% if unconfirmed %>
        <div class="tile">
          <span class="tile-icon"><%= account_icon(:email) %></span>
          <span class="tile-title"><%= account_text("check.email.title") %></span>
          <span class="tile-body"><%= account_text("check.email.body") %></span>
          <%= button_to account_text("email.send_link"), account_verification_path,
                class: "tile-go" %>
        </div>
      <% end %>

      <% if compromised.any? %>
        <a class="tile tile-bad" href="#passkeys">
          <span class="tile-icon"><%= account_icon(:passkey) %></span>
          <span class="tile-title"><%= account_text("check.passkey.title") %></span>
          <span class="tile-body">
            <%= account_text("check.passkey.body", count: compromised.size) %>
          </span>
          <span class="tile-go"><%= account_text("check.look") %></span>
        </a>
      <% end %>

      <% if blocked.any? %>
        <a class="tile tile-bad" href="#devices">
          <span class="tile-icon"><%= account_icon(:device) %></span>
          <span class="tile-title"><%= account_text("check.device.title") %></span>
          <span class="tile-body">
            <%= account_text("check.device.body", count: blocked.size) %>
          </span>
          <span class="tile-go"><%= account_text("check.look") %></span>
        </a>
      <% end %>
    </div>
  </section>
<% end %>
