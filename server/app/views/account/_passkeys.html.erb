<section id="passkeys" data-passkeys class="panel slab">
  <div class="panel-head">
    <h2 class="panel-title"><%= account_text("passkeys.heading") %></h2>
    <span class="panel-count"><%= passkeys.size %></span>
  </div>

  <% if passkeys.any? %>
    <ul class="chip-list">
      <% passkeys.each do |passkey| %>
        <li class="chip chip-stack">
          <span class="chip-line">
            <span class="chip-name">
              <% if passkey.icon %>
                <img src="<%= passkey.icon %>" alt="" width="16" height="16" />
              <% end %>
              <span><%= passkey.label %></span>
              <% if passkey.authenticator&.certified? %>
                <span class="tag"><%= account_text("passkeys.certified") %></span>
              <% end %>
            </span>
            <span class="chip-meta">
              <span>
                <%= passkey.last_used_at ?
                      account_text("passkeys.used", age: time_ago_in_words(passkey.last_used_at)) :
                      account_text("passkeys.never_used") %>
              </span>
              <%= button_to account_text("passkeys.remove"), passkey_path(passkey), method: :delete,
                    class: "textlink", form_class: "chip-action",
                    form: { data: { turbo_confirm: account_text("passkeys.confirm_remove") } } %>
            </span>
          </span>

          <% if passkey.compromised? %>
            <span class="aside aside-bad">
              <%= account_text("passkeys.compromised", report: passkey.compromise.downcase.tr("_", " ")) %>
            </span>
          <% end %>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p class="aside"><%= account_text("passkeys.explained") %></p>
  <% end %>

  <%= form_with url: passkeys_path, method: :post, id: "add-passkey",
        hidden: true, data: { challenge: passkey_challenge_path },
        class: "flow-tight" do |form| %>
    <%= form.hidden_field :credential, id: "passkey-credential" %>

    <label class="field">
      <span class="field-label"><%= account_text("passkeys.name") %></span>
      <%= form.text_field :name, id: "passkey-name",
            placeholder: account_text("passkeys.name_placeholder"), class: "control control-sm" %>
    </label>

    <button type="button" id="add-passkey-button" class="action action-quiet action-sm">
      <%= account_text("passkeys.add") %>
    </button>
  <% end %>

  <p id="passkey-unusable" hidden class="aside aside-bad"></p>
</section>
