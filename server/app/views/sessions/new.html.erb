<% content_for :title, "Sign in" %>

<div class="card">
  <h1>Sign in</h1>

  <% if @authorization&.client %>
    <p><strong><%= @authorization.client.name %></strong> is asking you to sign in.</p>
  <% end %>

  <%= form_with url: login_path, method: :post do |form| %>
    <label>
      Nickname or email
      <%= form.text_field :identifier, autocomplete: "username", autofocus: true %>
    </label>

    <label>
      Password
      <%= form.password_field :password, autocomplete: "current-password" %>
    </label>

    <div class="actions">
      <%= form.submit "Sign in" %>
    </div>
  <% end %>
</div>
