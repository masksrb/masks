<% content_for :title, "Authorize #{@client.name}" %>

<div class="flex flex-col gap-4">
  <div class="flex flex-col gap-1">
    <h1 class="text-2xl font-bold"><%= @client.name %> wants access</h1>
    <p class="text-sm opacity-75">
      Signed in as <strong class="font-semibold"><%= current_actor.nickname %></strong>.
    </p>
  </div>

  <h2 class="text-xs font-bold uppercase opacity-75">It is asking to</h2>
  <ul class="flex flex-col gap-2">
    <% @scopes.each do |scope, description| %>
      <li class="flex items-baseline justify-between gap-3 rounded-lg border border-base-content/15 bg-base-200 px-3 py-2">
        <span class="text-sm"><%= description || "Use the #{scope} scope" %></span>
        <span class="font-mono text-xs opacity-75"><%= scope %></span>
      </li>
    <% end %>
  </ul>

  <% if @audience.any? %>
    <h2 class="text-xs font-bold uppercase opacity-75">On your behalf at</h2>
    <% @audience.each do |resource| %>
      <p class="font-mono text-xs break-all opacity-75"><%= resource %></p>
    <% end %>
  <% end %>

  <%= form_with url: consent_path, method: :post do |form| %>
    <div class="flex gap-2">
      <%= form.submit "Allow", name: "approve", value: "yes", class: "btn btn-primary grow" %>
      <%= form.submit "Deny", name: "deny", value: "yes", class: "btn btn-ghost" %>
    </div>
  <% end %>

  <p class="text-sm opacity-75">
    Not you? <%= link_to "Sign out", logout_path, class: "link" %>.
  </p>
</div>
