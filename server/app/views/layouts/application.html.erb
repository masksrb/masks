<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= content_for(:title) || "masks" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="color-scheme" content="light dark">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
  </head>

  <body>
    <main class="frame">
      <header class="frame-head">
        <span class="mark">masks</span>
        <span class="tenant"><%= Current.tenant&.name %></span>
      </header>

      <% if flash[:alert].present? %>
        <p class="notice notice-alert"><%= flash[:alert] %></p>
      <% end %>
      <% if flash[:notice].present? %>
        <p class="notice"><%= flash[:notice] %></p>
      <% end %>

      <%= yield %>
    </main>
  </body>
</html>
