<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= content_for(:title) || Current.tenant&.name %></title>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="color-scheme" content="light dark">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= vite_client_tag %>
    <%= vite_stylesheet_tag "app" %>
    <%= yield :scripts %>
  </head>

  <body class="auth-page">
    <main class="auth-card <%= content_for(:surface) %>">
      <div class="auth-rail"><%= Current.tenant&.name || "Sign in" %></div>

      <div class="auth-body flow">
        <% if flash[:alert].present? %>
          <div class="note note-bad" role="alert"><%= flash[:alert] %></div>
        <% end %>
        <% if flash[:notice].present? %>
          <div class="note"><%= flash[:notice] %></div>
        <% end %>

        <%= yield %>
      </div>
    </main>
  </body>
</html>
