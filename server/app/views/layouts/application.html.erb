<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= content_for(:title) || Current.tenant&.name %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="color-scheme" content="light dark">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= vite_client_tag %>
    <%= vite_stylesheet_tag "app" %>
    <%= yield :scripts %>
  </head>

  <body class="background animate-fade-in min-h-screen flex flex-col items-center justify-center px-[5px] md:p-3">
    <main class="w-full max-w-[500px] mx-auto rounded-2xl shadow-2xl overflow-hidden">
      <div class="h-[25px] md:h-[32px] bg-base-200/90 backdrop-blur"></div>

      <div class="bg-base-100/90 backdrop-blur px-5 md:px-8 pt-6 pb-6 flex flex-col gap-4">
        <% if flash[:alert].present? %>
          <div class="alert alert-error" role="alert"><%= flash[:alert] %></div>
        <% end %>
        <% if flash[:notice].present? %>
          <div class="alert alert-info"><%= flash[:notice] %></div>
        <% end %>

        <%= yield %>
      </div>
    </main>
  </body>
</html>
