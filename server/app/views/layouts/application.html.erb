<!DOCTYPE html>
<html lang="<%= Locales.tag %>">
  <head>
    <title><%= content_for(:title) || Current.tenant&.name %></title>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="color-scheme" content="light dark">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= vite_client_tag %>
    <%= vite_stylesheet_tag "app" %>
    <%= yield :scripts %>
  </head>

  <% surface = content_for(:surface).to_s.strip.presence || "challenge" %>

  <body class="auth-page">
    <main class="auth-col surface-<%= surface %>">
      <% if surface == "challenge" && Current.tenant&.name.present? %>
        <div class="auth-id">
          <span class="auth-mark" aria-hidden="true"><%= Current.tenant.name.first.upcase %></span>
          <span class="auth-tenant"><%= Current.tenant.name %></span>
        </div>
      <% end %>

      <div class="flow">
        <% if flash[:alert].present? %>
          <div class="note note-bad" role="alert"><%= flash[:alert] %></div>
        <% end %>
        <% if flash[:notice].present? %>
          <div class="note"><%= flash[:notice] %></div>
        <% end %>

        <%= yield %>
      </div>
    </main>
  </body>
</html>
