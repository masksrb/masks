<!DOCTYPE html>
<html lang="<%= Locales.tag %>">
  <head>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="color-scheme" content="light dark">
    <meta name="supported-color-schemes" content="light dark">
    <title><%= message.subject %></title>
    <style>
      :root {
        color-scheme: light dark;
        supported-color-schemes: light dark;
      }

      body {
        margin: 0;
        padding: 0;
        width: 100% !important;
        background-color: #fcf9f7;
        font-family: "Helvetica Neue", Helvetica, Arial, sans-serif;
        -webkit-font-smoothing: antialiased;
      }

      .ground {
        background-color: #fcf9f7;
        padding: 40px 20px 48px;
      }

      .col {
        width: 100%;
        max-width: 480px;
        margin: 0 auto;
      }

      .mark {
        width: 44px;
        height: 44px;
        border-radius: 5px;
        background-color: #f5f1ee;
        border: 1px solid #e5ded9;
        color: #b04000;
        font-size: 17px;
        font-weight: 700;
        letter-spacing: -0.02em;
        text-align: center;
        vertical-align: middle;
        font-family: "Helvetica Neue", Helvetica, Arial, sans-serif;
      }

      .tenant {
        padding-top: 12px;
        font-size: 12px;
        font-weight: 700;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: #87611e;
        text-align: center;
      }

      .card {
        background-color: #ffffff;
        border: 1px solid #e5ded9;
        border-radius: 5px;
        padding: 28px 28px 24px;
      }

      .lede {
        margin: 0;
        font-size: 16px;
        line-height: 1.5;
        color: #211c18;
      }

      .lede + .lede {
        margin-top: 12px;
      }

      .strong {
        font-weight: 700;
        color: #211c18;
      }

      .btn-wrap {
        padding: 24px 0 4px;
      }

      .btn-cell {
        background-color: #b04000;
        border-radius: 3px;
      }

      .btn {
        display: inline-block;
        padding: 12px 22px;
        font-size: 15px;
        font-weight: 700;
        line-height: 1;
        color: #ffffff;
        text-decoration: none;
        font-family: "Helvetica Neue", Helvetica, Arial, sans-serif;
      }

      .fallback {
        margin: 16px 0 0;
        font-size: 12px;
        line-height: 1.6;
        color: #58514c;
        word-break: break-all;
      }

      .fallback a {
        color: #87611e;
        text-decoration: underline;
      }

      .meta {
        margin: 22px 0 0;
        padding-top: 18px;
        border-top: 1px solid #e5ded9;
        font-size: 13px;
        line-height: 1.6;
        color: #58514c;
      }

      .foot {
        padding-top: 20px;
        font-size: 12px;
        line-height: 1.6;
        color: #58514c;
        text-align: center;
      }

      @media (prefers-color-scheme: dark) {
        body, .ground {
          background-color: #000000 !important;
        }

        .mark {
          background-color: #0f0b09 !important;
          border-color: #292421 !important;
          color: #ff8f53 !important;
        }

        .tenant {
          color: #b58a41 !important;
        }

        .card {
          background-color: #0f0b09 !important;
          border-color: #292421 !important;
        }

        .lede, .strong {
          color: #e9e5e2 !important;
        }

        .btn-cell {
          background-color: #ff8f53 !important;
        }

        .btn {
          color: #1a1614 !important;
        }

        .fallback, .meta, .foot {
          color: #aca6a2 !important;
        }

        .fallback a {
          color: #b58a41 !important;
        }

        .meta {
          border-top-color: #292421 !important;
        }
      }
    </style>
  </head>

  <body>
    <table role="presentation" class="ground" width="100%" cellpadding="0" cellspacing="0" border="0">
      <tr>
        <td align="center">
          <!--[if mso]><table role="presentation" width="480" cellpadding="0" cellspacing="0" border="0"><tr><td><![endif]-->
          <table role="presentation" class="col" width="100%" cellpadding="0" cellspacing="0" border="0">
            <tr>
              <td align="center">
                <table role="presentation" cellpadding="0" cellspacing="0" border="0">
                  <tr>
                    <td class="mark" width="44" height="44" align="center"><%= @tenant_name.to_s.first.to_s.upcase %></td>
                  </tr>
                </table>
              </td>
            </tr>
            <tr>
              <td class="tenant"><%= @tenant_name %></td>
            </tr>
            <tr>
              <td height="24" style="height: 24px; line-height: 24px; font-size: 0;">&nbsp;</td>
            </tr>
            <tr>
              <td>
                <table role="presentation" class="card" width="100%" cellpadding="0" cellspacing="0" border="0">
                  <tr>
                    <td><%= yield %></td>
                  </tr>
                </table>
              </td>
            </tr>
            <tr>
              <td class="foot"><%= t("actor_mailer.shared.sent_by_html", tenant: @tenant_name) %></td>
            </tr>
          </table>
          <!--[if mso]></td></tr></table><![endif]-->
        </td>
      </tr>
    </table>
  </body>
</html>
