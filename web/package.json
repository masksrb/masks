{
  "name": "@masks/client",
  "version": "2.0.0",
  "description": "An OIDC client for masks: a session against a backend-for-frontend, or the code flow in the browser.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/masksrb/masks.git",
    "directory": "web"
  },
  "homepage": "https://github.com/masksrb/masks/tree/main/web#readme",
  "bugs": "https://github.com/masksrb/masks/issues",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "test": "node --test test/*.test.js"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.15",
    "typescript": "^6.0.3"
  }
}
