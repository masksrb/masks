#!/usr/bin/env ruby
# frozen_string_literal: true

require "json"
require "net/http"
require "open3"
require "shellwords"

ROOT = __dir__

APP_PORT = ENV.fetch("MASKS_PORT", "12345")
DOCS_PORT = ENV.fetch("MASKS_DOCS_PORT", "12346")
IMAGE_PORT = ENV.fetch("MASKS_IMAGE_PORT", "5556")

USAGE = <<~TEXT
  usage: dev [command] [--multi]

    up             build and run the stack in the foreground
    down           stop it, keeping the volumes
    reset          throw the volumes away and start over
    logs [service] follow one service, or all of them
    ps             what is running
    psql           a shell on postgres
    console        a rails console
    test [suite]   unit, integration, engine, client, web, conformance
    image [build]  run the production image the way it deploys, and check it
    conformance    up | run | logs | down | plans
    reference      regenerate the reference pages from the code
    fmt [--check]  format everything, or check it

  One tenant answers at http://masks.localhost:#{APP_PORT}, its docs at
  http://masks.localhost:#{DOCS_PORT}. With --multi the stack declares demo and
  acme instead, at http://demo.masks.localhost:#{APP_PORT}.
TEXT

def die(message)
  warn message
  exit 1
end

def usage
  warn USAGE
  exit 64
end

def run(*command, chdir: ROOT)
  system(*command, chdir: chdir)
end

def run!(*command, chdir: ROOT)
  run(*command, chdir: chdir) || die("failed: #{command.shelljoin}")
end

def compose(*args, multi: false, profile: nil)
  files = [ "compose.yml", *("compose.multi.yml" if multi) ]

  [ "docker", "compose",
   *files.flat_map { |file| [ "-f", file ] },
   *([ "--profile", profile ] if profile),
   *args ]
end

def announce(multi)
  hosts = multi ? %w[demo acme].map { |t| "#{t}.masks.localhost" } : [ "masks.localhost" ]

  puts
  hosts.each { |host| puts "  masks   http://#{host}:#{APP_PORT}" }
  puts "  docs    http://masks.localhost:#{DOCS_PORT}"
  puts
end

def up(multi)
  announce(multi)
  run!(*compose("up", "--build", "--abort-on-container-failure", multi: multi))
end

def get(url)
  response = Net::HTTP.get_response(URI(url))
  response.is_a?(Net::HTTPSuccess) ? response.body : die("#{url} answered #{response.code}")
rescue SystemCallError => error
  die("#{url} is unreachable: #{error.message}")
end

def image(args)
  return run!(*compose("build", "masks-image", profile: "image")) if args.first == "build"

  run!(*compose("up", "-d", "--build", "--wait", "masks-image", profile: "image"))

  kids = %w[demo acme].map do |tenant|
    origin = "http://#{tenant}.masks.localhost:#{IMAGE_PORT}"
    config = JSON.parse(get("#{origin}/.well-known/openid-configuration"))

    unless config["issuer"] == origin
      die("#{tenant} advertises #{config["issuer"].inspect}, expected #{origin.inspect}")
    end

    keys = JSON.parse(get("#{origin}/.well-known/jwks.json"))["keys"]
    die("#{tenant} publishes no signing keys") if keys.nil? || keys.empty?

    keys.first["kid"]
  end

  die("both tenants sign with #{kids.first} — keys are not per-tenant") if kids.uniq.size == 1

  puts "\n  demo and acme each answer at their own origin, with keys of their own."
  puts "  http://demo.masks.localhost:#{IMAGE_PORT}\n\n"
end

SUITE_REF = ENV.fetch("SUITE_REF", "release-v5.2.4")
SUITE_REPO = ENV.fetch("SUITE_REPO", "https://gitlab.com/openid/conformance-suite.git")

PLANS = [
  "oidcc-config-certification-test-plan",
  "oidcc-basic-certification-test-plan[server_metadata=discovery][client_registration=dynamic_client]"
].freeze

def conformance(args)
  here = File.join(ROOT, "test", "conformance")
  suite = File.join(here, ".suite")
  ENV["SUITE_REF"] = SUITE_REF
  ENV["SUITE_PORT"] ||= "8443"

  case args.first
  when "logs" then return run("docker", "compose", "logs", "-f", args[1] || "server", chdir: here)
  when "down" then return run("docker", "compose", "down", "-v", "--remove-orphans", chdir: here)
  when "plans" then return puts(PLANS)
  end

  if File.directory?(File.join(suite, ".git"))
    run!("git", "-C", suite, "fetch", "--depth", "1", "origin", "refs/tags/#{SUITE_REF}")
    run!("git", "-C", suite, "checkout", "--detach", "FETCH_HEAD")
  else
    run!("git", "clone", "--depth", "1", "--branch", SUITE_REF, SUITE_REPO, suite)
  end

  Dir.mkdir(File.join(here, "results")) unless File.directory?(File.join(here, "results"))

  run!("docker", "compose", "up", "-d", "--wait", "masks", "proxy", "mongodb", "server", "nginx",
       chdir: here)
  run!("sh", "-c", "docker compose exec -T masks ./bin/rails runner - < owner.rb", chdir: here)

  return true if args.first == "up"

  plan = PLANS.flat_map { |name| [ "'#{name}'", "/conformance/masks.json" ] }.join(" ")

  run("sh", "-c", <<~SH, chdir: here)
    docker compose run --rm runner \
      "pip install --quiet -r /suite/scripts/requirements.txt && \
       exec python /suite/scripts/run-test-plan.py \
         --export-dir /results \
         --expected-failures-file /conformance/expected-failures.json \
         --expected-skips-file /conformance/expected-skips.json \
         --verbose #{plan}" 2>&1 | tee results/run.log
  SH
end

def reference
  run!("bin/rails", "docs:reference", chdir: File.join(ROOT, "server"))

  client = File.join(ROOT, "client")
  run("sh", "-c", "bundle check >/dev/null 2>&1 || bundle install --quiet", chdir: client)
  run!("bundle", "exec", "rake", "reference:mdx", chdir: client)

  docs = File.join(ROOT, "docs")
  run!("npm", "ci", chdir: docs) unless File.directory?(File.join(docs, "node_modules"))
  run!("npm", "run", "reference", chdir: docs)
end

GLOBS = [
  "*.{yml,yaml,md}",
  ".github/**/*.{yml,yaml}",
  "server/config/**/*.{yml,yaml}",
  "test/conformance/**/*.{yml,yaml}"
].freeze

def shellcheck
  scripts, = Open3.capture2("shfmt", "-f", "server/bin", chdir: ROOT)
  scripts = scripts.split("\n").reject(&:empty?)

  scripts.empty? || run("shellcheck", *scripts)
end

def fmt(args)
  usage unless args.empty? || args == [ "--check" ]
  check = args.first == "--check"

  %w[shfmt shellcheck].each do |tool|
    next if system("command -v #{tool} > /dev/null")

    die("#{tool} is not on your PATH, and CI checks with it. brew bundle")
  end

  ok = [
    run("bundle", "exec", "rubocop", *(check ? [ "--format", ENV.fetch("RUBOCOP_FORMAT", "progress") ] : [ "-a" ])),
    *%w[server web].map do |dir|
      run("npx", "biome", "check", *([ "--write" ] unless check), chdir: File.join(ROOT, dir))
    end,
    run("npx", "--yes", "prettier@3.9.6", check ? "--check" : "--write",
        "--no-error-on-unmatched-pattern", *GLOBS),
    run("shfmt", check ? "-d" : "-w", "-i", "2", "-ci", "server/bin"),
    shellcheck
  ]

  exit(ok.all? ? 0 : 1)
end

SUITES = {
  "unit" => [ "server", "bin/rake", "db:prepare", "test:unit" ],
  "integration" => [ "server", "bin/rake", "db:prepare", "test:integration" ],
  "engine" => [ "client", "sh", "-c", "bundle install --quiet && bundle exec rake test:engine" ],
  "client" => [ "client", "sh", "-c", "bundle install --quiet && bundle exec rake test:client" ],
  "web" => [ "web" ]
}.freeze

def tests(*args)
  [ "docker", "compose", "-f", "compose.test.yml",
    *([ "-f", "compose.test.ci.yml" ] if ENV["CI"]),
    *args ].compact
end

def test(names)
  names = SUITES.keys + [ "conformance" ] if names.empty?
  names.each { |name| usage unless SUITES.key?(name) || name == "conformance" }

  failed = names.reject do |name|
    puts "\n== #{name}\n\n"

    if name == "conformance"
      conformance([ "run" ])
    else
      run(*tests("run", "--rm", "--build", *SUITES.fetch(name)))
    end
  end

  run(*tests("down", "--remove-orphans"))

  die("\nfailed: #{failed.join(' ')}") if failed.any?
  puts "\npassed: #{names.join(' ')}"
end

command = ARGV.shift || "up"
multi = !ARGV.delete("--multi").nil?

case command
when "up" then up(multi)
when "down" then run!(*compose("down", multi: multi, profile: "image"))
when "reset"
  run!(*compose("down", "-v", "--remove-orphans", multi: multi, profile: "image"))
  up(multi)
when "logs" then run!(*compose("logs", "-f", *ARGV, multi: multi))
when "ps" then run!(*compose("ps", multi: multi))
when "psql" then run!(*compose("exec", "postgres", "psql", "-U", "postgres", multi: multi))
when "console" then run!(*compose("exec", "masks", "bin/rails", "console", multi: multi))
when "image" then image(ARGV)
when "test" then test(ARGV)
when "conformance" then conformance(ARGV)
when "reference" then reference
when "fmt" then fmt(ARGV)
else usage
end
