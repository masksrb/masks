#!/usr/bin/env ruby
# frozen_string_literal: true

require "json"
require "net/http"
require "open3"
require "openssl"
require "shellwords"

ROOT = __dir__

APP_PORT = ENV.fetch("MASKS_PORT", "12345")
DOCS_PORT = ENV.fetch("MASKS_DOCS_PORT", "12346")
IMAGE_PORT = ENV.fetch("MASKS_IMAGE_PORT", "5556")

USAGE = <<~TEXT
  usage: dev [command] [--multi]

    up             build and run the stack in the foreground
    down           stop it, keeping the volumes
    reset          throw the volumes away and start over
    logs [service] follow one service, or all of them
    ps             what is running
    psql           a shell on postgres
    console        a rails console
    test [suite]   unit, integration, provider, engine, client, web, conformance
    image [build]  run the production image the way it deploys, and check it
    first-sign-in [image]  time a fresh image to its first signed-in account
    conformance    up | run | logs | down | plans
    reference      regenerate the reference pages from the code
    fmt [--check]  format everything, or check it

  One tenant answers at http://masks.localhost:#{APP_PORT}, its docs at
  http://masks.localhost:#{DOCS_PORT}. With --multi the stack declares demo and
  acme instead, at http://demo.masks.localhost:#{APP_PORT}.
TEXT

def die(message)
  warn message
  exit 1
end

def usage
  warn USAGE
  exit 64
end

def run(*command, chdir: ROOT)
  system(*command, chdir: chdir)
end

def run!(*command, chdir: ROOT)
  run(*command, chdir: chdir) || die("failed: #{command.shelljoin}")
end

def compose(*args, multi: false, profile: nil)
  files = [ "compose.yml", *("compose.multi.yml" if multi) ]

  [ "docker", "compose",
   *files.flat_map { |file| [ "-f", file ] },
   *([ "--profile", profile ] if profile),
   *args ]
end

def announce(multi)
  hosts = multi ? %w[demo acme].map { |t| "#{t}.masks.localhost" } : [ "masks.localhost" ]

  puts
  hosts.each { |host| puts "  masks   http://#{host}:#{APP_PORT}" }
  puts "  docs    http://masks.localhost:#{DOCS_PORT}"
  puts
end

def up(multi)
  announce(multi)
  run!(*compose("up", "--build", "--abort-on-container-failure", multi: multi))
end

def get(url)
  response = Net::HTTP.get_response(URI(url))
  response.is_a?(Net::HTTPSuccess) ? response.body : die("#{url} answered #{response.code}")
rescue SystemCallError => error
  die("#{url} is unreachable: #{error.message}")
end

def image(args)
  return run!(*compose("build", "masks-image", profile: "image")) if args.first == "build"

  run!(*compose("up", "-d", "--build", "--wait", "masks-image", profile: "image"))

  kids = %w[demo acme].map do |tenant|
    origin = "http://#{tenant}.masks.localhost:#{IMAGE_PORT}"
    config = JSON.parse(get("#{origin}/.well-known/openid-configuration"))

    unless config["issuer"] == origin
      die("#{tenant} advertises #{config["issuer"].inspect}, expected #{origin.inspect}")
    end

    keys = JSON.parse(get("#{origin}/.well-known/jwks.json"))["keys"]
    die("#{tenant} publishes no signing keys") if keys.nil? || keys.empty?

    keys.first["kid"]
  end

  die("both tenants sign with #{kids.first} — keys are not per-tenant") if kids.uniq.size == 1

  puts "\n  demo and acme each answer at their own origin, with keys of their own."
  puts "  http://demo.masks.localhost:#{IMAGE_PORT}\n\n"
end

FIRST_SIGN_IN_PORT = ENV.fetch("MASKS_FIRST_SIGN_IN_PORT", "5557")
FIRST_SIGN_IN_BUDGET = ENV.fetch("MASKS_FIRST_SIGN_IN_BUDGET", "120").to_i
FIRST_SIGN_IN_TOKEN = ENV.fetch("MASKS_FIRST_SIGN_IN_TOKEN", "first-sign-in-setup-token-not-for-real-use")
FIRST_SIGN_IN_PASSWORD = "a-long-enough-password-for-the-first-manager"

class FirstSignIn
  Refused = Class.new(StandardError)

  def initialize(port:)
    @http = Net::HTTP.new("127.0.0.1", port.to_i)
    @host = "localhost:#{port}"
    @cookies = {}
    @csrf = ""
  end

  def set_up!(token:)
    page = get("/login")
    refuse("the setup screen did not show: /login answered #{page.code}") unless page.code == "200" && page.body.include?("Set up")

    body = post("signup", token: token, nickname: "owner", email: "owner@example.invalid",
                          password: FIRST_SIGN_IN_PASSWORD, password_confirmation: FIRST_SIGN_IN_PASSWORD)
    refuse("the first account was not created", body) unless body["prompt"] == "enrol"

    secret = body.dig("enrolment", "otp", "secret").to_s.delete(" ")
    refuse("no authenticator secret was offered", body) if secret.empty?

    body = post("enrol:otp", code: totp(secret))
    refuse("the authenticator code was not accepted", body) if body["warnings"].to_a.any?

    body = post("enrol:done", kept: "1")
    refuse("the second factor was not finished", body) unless body["prompt"] == "setup-configure"

    body = post("setup-configure", called: "Acme")
    refuse("setup did not settle", body) unless body["settled"]

    page = get("/")
    refuse("the account page did not answer 200 after setup: #{page.code}") unless page.code == "200"
    refuse("the account page does not show the manager") unless page.body.include?("owner")
  end

  private

    def refuse(message, body = nil)
      detail = body && (body["warnings"] || body["prompt"])

      raise Refused, [ message, detail && detail.inspect ].compact.join(": ")
    end

    def get(path)
      request(Net::HTTP::Get.new(path, "Accept" => "text/html"))
    end

    def post(event, **fields)
      request = Net::HTTP::Post.new("/login", "Content-Type" => "application/json",
                                              "Accept" => "application/json", "X-CSRF-Token" => @csrf)
      request.body = JSON.generate({ "event" => event }.merge(fields))

      JSON.parse(request(request).body)
    end

    def request(request)
      request["Host"] = @host
      request["Cookie"] = @cookies.map { |name, value| "#{name}=#{value}" }.join("; ") if @cookies.any?

      response = @http.request(request)

      response.get_fields("set-cookie").to_a.each do |cookie|
        name, value = cookie.split(";", 2).first.split("=", 2)
        @cookies[name] = value
      end

      @csrf = response.body[/name="csrf-token" content="([^"]+)"/, 1] || @csrf if response["content-type"].to_s.include?("html")

      response
    end

    def totp(secret)
      alphabet = "ABCDEFGHIJKLMNOPQRSTUVWXYZ234567"
      bits = secret.upcase.delete("=").each_char.map { |char| alphabet.index(char).to_s(2).rjust(5, "0") }.join
      key = [ bits[0, bits.size - bits.size % 8] ].pack("B*")
      digest = OpenSSL::HMAC.digest("SHA1", key, [ Time.now.to_i / 30 ].pack("Q>"))
      offset = digest.bytes.last & 0x0f

      format("%06d", (digest[offset, 4].unpack1("N") & 0x7fffffff) % 1_000_000)
    end
end

def first_sign_in(args)
  image = args.first || "masks:dev"
  here = File.join(ROOT, "test", "first_sign_in")
  env = { "MASKS_IMAGE" => image, "MASKS_FIRST_SIGN_IN_PORT" => FIRST_SIGN_IN_PORT,
          "MASKS_FIRST_SIGN_IN_TOKEN" => FIRST_SIGN_IN_TOKEN }
  stack = ->(*command) { system(env, "docker", "compose", *command, chdir: here) }
  clock = -> { Process.clock_gettime(Process::CLOCK_MONOTONIC) }

  unless system("docker", "image", "inspect", image, out: File::NULL, err: File::NULL)
    run!("docker", "pull", image)
  end
  stack.call("down", "-v", "--remove-orphans")

  started = clock.call
  stack.call("up", "-d", "--quiet-pull") || die("the stack did not start")

  up = URI("http://127.0.0.1:#{FIRST_SIGN_IN_PORT}/up")
  loop do
    begin
      break if Net::HTTP.get_response(up).is_a?(Net::HTTPSuccess)
    rescue SystemCallError, IOError
      nil
    end

    die("masks did not answer /up within #{FIRST_SIGN_IN_BUDGET} seconds") if clock.call - started > FIRST_SIGN_IN_BUDGET
    sleep 0.5
  end
  booted = clock.call

  FirstSignIn.new(port: FIRST_SIGN_IN_PORT).set_up!(token: FIRST_SIGN_IN_TOKEN)
  signed_in = clock.call

  boot = booted - started
  sign_in = signed_in - booted
  total = signed_in - started

  puts "\n  #{image}: #{format('%.1f', boot)} s from the containers starting to /up answering 200,"
  puts "  then #{format('%.1f', sign_in)} s to set up and sign in the first manager."
  puts "  #{format('%.1f', total)} s from a fresh image to a signed-in account, budget #{FIRST_SIGN_IN_BUDGET} s.\n\n"

  if ENV["GITHUB_STEP_SUMMARY"]
    File.open(ENV["GITHUB_STEP_SUMMARY"], "a") do |summary|
      summary.puts "## First sign-in from a fresh image"
      summary.puts
      summary.puts "| Step | Seconds |"
      summary.puts "| --- | ---: |"
      summary.puts "| Containers starting to `/up` answering 200 | #{format('%.1f', boot)} |"
      summary.puts "| `/up` to the first manager set up and signed in | #{format('%.1f', sign_in)} |"
      summary.puts "| Total, budget #{FIRST_SIGN_IN_BUDGET} | #{format('%.1f', total)} |"
    end
  end

  die("the first sign-in took #{format('%.1f', total)} s, over the budget of #{FIRST_SIGN_IN_BUDGET} s") if total > FIRST_SIGN_IN_BUDGET
rescue FirstSignIn::Refused => error
  stack.call("logs", "--no-color", "masks")
  die("first sign-in failed: #{error.message}")
ensure
  stack&.call("down", "-v", "--remove-orphans")
end

SUITE_REF = ENV.fetch("SUITE_REF", "release-v5.2.4")
SUITE_REPO = ENV.fetch("SUITE_REPO", "https://gitlab.com/openid/conformance-suite.git")

PLANS = [
  "oidcc-config-certification-test-plan",
  "oidcc-basic-certification-test-plan[server_metadata=discovery][client_registration=dynamic_client]",
  "oidcc-rp-initiated-logout-certification-test-plan[response_type=code][client_registration=dynamic_client]",
  "oidcc-backchannel-rp-initiated-logout-certification-test-plan[response_type=code][client_registration=dynamic_client]"
].freeze

SUITE_HOST = "localhost.emobix.co.uk".freeze

def certificate(subject, key, issuer: nil, signer: key, ca: false)
  cert = OpenSSL::X509::Certificate.new
  cert.version = 2
  cert.serial = OpenSSL::BN.rand(64)
  cert.subject = OpenSSL::X509::Name.parse(subject)
  cert.issuer = issuer || cert.subject
  cert.public_key = key
  cert.not_before = Time.now - 60
  cert.not_after = Time.now + (30 * 24 * 60 * 60)

  extensions = OpenSSL::X509::ExtensionFactory.new(issuer ? nil : cert, cert)
  extensions.issuer_certificate = cert unless issuer
  cert.add_extension(extensions.create_extension("basicConstraints", ca ? "CA:TRUE" : "CA:FALSE", true))
  cert.add_extension(extensions.create_extension("subjectAltName", "DNS:#{SUITE_HOST}")) unless ca
  cert.sign(signer, OpenSSL::Digest.new("SHA256"))
  cert
end

def suite_certificates(dir)
  return if File.exist?(File.join(dir, "suite.crt"))

  Dir.mkdir(dir) unless File.directory?(dir)

  ca_key = OpenSSL::PKey::RSA.new(2048)
  ca = certificate("/CN=masks conformance", ca_key, ca: true)
  key = OpenSSL::PKey::RSA.new(2048)
  leaf = certificate("/CN=#{SUITE_HOST}", key, issuer: ca.subject, signer: ca_key)

  File.write(File.join(dir, "ca.crt"), ca.to_pem)
  File.write(File.join(dir, "suite.crt"), leaf.to_pem + ca.to_pem)
  File.write(File.join(dir, "suite.key"), key.to_pem)
  File.chmod(0o644, File.join(dir, "suite.key"))
end

def conformance(args)
  here = File.join(ROOT, "test", "conformance")
  suite = File.join(here, ".suite")
  ENV["SUITE_REF"] = SUITE_REF
  ENV["SUITE_PORT"] ||= "8443"

  case args.first
  when "logs" then return run("docker", "compose", "logs", "-f", args[1] || "server", chdir: here)
  when "down" then return run("docker", "compose", "down", "-v", "--remove-orphans", chdir: here)
  when "plans"
    puts PLANS
    return true
  end

  if File.directory?(File.join(suite, ".git"))
    run!("git", "-C", suite, "fetch", "--depth", "1", "origin", "refs/tags/#{SUITE_REF}")
    run!("git", "-C", suite, "checkout", "--detach", "FETCH_HEAD")
  else
    run!("git", "clone", "--depth", "1", "--branch", SUITE_REF, SUITE_REPO, suite)
  end

  Dir.mkdir(File.join(here, "results")) unless File.directory?(File.join(here, "results"))
  suite_certificates(File.join(here, "certs"))

  run!("docker", "compose", "up", "-d", "--build", "--wait", "masks", "proxy", "mongodb", "server", "nginx",
       chdir: here)
  run!("sh", "-c", "docker compose exec -T masks ./bin/rails runner - < owner.rb", chdir: here)

  return true if args.first == "up"

  plan = PLANS.flat_map { |name| [ "'#{name}'", "/conformance/masks.json" ] }.join(" ")

  run("bash", "-o", "pipefail", "-c", <<~SH, chdir: here)
    docker compose run --rm runner \
      "pip install --quiet -r /suite/scripts/requirements.txt && \
       exec python /suite/scripts/run-test-plan.py \
         --export-dir /results \
         --expected-failures-file /conformance/expected-failures.json \
         --expected-skips-file /conformance/expected-skips.json \
         --verbose #{plan}" 2>&1 | tee results/run.log
  SH
end

def reference
  run!("bin/rails", "docs:reference", chdir: File.join(ROOT, "server"))

  client = File.join(ROOT, "client")
  run("sh", "-c", "bundle check >/dev/null 2>&1 || bundle install --quiet", chdir: client)
  run!("bundle", "exec", "rake", "reference:mdx", chdir: client)

  web = File.join(ROOT, "web")
  run!("npm", "ci", chdir: web) unless File.directory?(File.join(web, "node_modules"))

  docs = File.join(ROOT, "docs")
  run!("npm", "ci", chdir: docs) unless File.directory?(File.join(docs, "node_modules"))
  run!("npm", "run", "reference", chdir: docs)
  run!("node", "bin/environment.mjs", chdir: docs)
end

GLOBS = [
  "*.{yml,yaml,md}",
  ".github/**/*.{yml,yaml}",
  "server/config/**/*.{yml,yaml}",
  "test/conformance/**/*.{yml,yaml}"
].freeze

def shellcheck
  scripts, = Open3.capture2("shfmt", "-f", "server/bin", chdir: ROOT)
  scripts = scripts.split("\n").reject(&:empty?)

  scripts.empty? || run("shellcheck", *scripts)
end

def gofmt(check)
  dir = File.join(ROOT, "go")

  return run("gofmt", "-w", ".", chdir: dir) unless check

  unformatted, = Open3.capture2("gofmt", "-l", ".", chdir: dir)
  return true if unformatted.empty?

  warn("gofmt would change:\n#{unformatted}")
  false
end

def ruff(check)
  python = File.join(ROOT, "python")
  formatted = run("uv", "run", "--frozen", "ruff", "format", *([ "--check" ] if check), chdir: python)
  linted = run("uv", "run", "--frozen", "ruff", "check", *([ "--fix" ] unless check), chdir: python)

  formatted && linted
end

def fmt(args)
  usage unless args.empty? || args == [ "--check" ]
  check = args.first == "--check"

  %w[shfmt shellcheck gofmt uv].each do |tool|
    next if system("command -v #{tool} > /dev/null")

    die("#{tool} is not on your PATH, and CI checks with it. brew bundle")
  end

  ok = [
    run("bundle", "exec", "rubocop", *(check ? [ "--format", ENV.fetch("RUBOCOP_FORMAT", "progress") ] : [ "-a" ])),
    *%w[server web node].map do |dir|
      run("npx", "biome", "check", *([ "--write" ] unless check), chdir: File.join(ROOT, dir))
    end,
    run("npx", "--yes", "prettier@3.9.6", check ? "--check" : "--write",
        "--no-error-on-unmatched-pattern", *GLOBS),
    run("shfmt", check ? "-d" : "-w", "-i", "2", "-ci", "server/bin"),
    shellcheck,
    gofmt(check),
    ruff(check)
  ]

  exit(ok.all? ? 0 : 1)
end

SUITES = {
  "unit" => [ "server", "bin/rake", "db:prepare", "test:unit" ],
  "integration" => [ "server", "bin/rake", "db:prepare", "test:integration" ],
  "provider" => [ "server", "bundle", "exec", "ruby", "-I/test/provider", "-e",
                  "Dir['/test/provider/*_test.rb'].sort.each { |file| require file }" ],
  "engine" => [ "client", "sh", "-c", "bundle install --quiet && bundle exec rake test:engine" ],
  "client" => [ "client", "sh", "-c", "bundle install --quiet && bundle exec rake test:client" ],
  "web" => [ "web" ]
}.freeze

def tests(*args)
  [ "docker", "compose", "-f", "compose.test.yml",
    *([ "-f", "compose.test.ci.yml" ] if ENV["CI"]),
    *args ].compact
end

def test(names)
  names = SUITES.keys + [ "conformance" ] if names.empty?
  names.each { |name| usage unless SUITES.key?(name) || name == "conformance" }

  failed = names.reject do |name|
    puts "\n== #{name}\n\n"

    if name == "conformance"
      conformance([ "run" ])
    else
      run(*tests("run", "--rm", "--build", *SUITES.fetch(name)))
    end
  end

  run(*tests("down", "--remove-orphans"))

  die("\nfailed: #{failed.join(' ')}") if failed.any?
  puts "\npassed: #{names.join(' ')}"
end

command = ARGV.first == "--multi" ? "up" : ARGV.shift || "up"
multi = !ARGV.delete("--multi").nil?

case command
when "up" then up(multi)
when "down" then run!(*compose("down", multi: multi, profile: "image"))
when "reset"
  run!(*compose("down", "-v", "--remove-orphans", multi: multi, profile: "image"))
  up(multi)
when "logs" then run!(*compose("logs", "-f", *ARGV, multi: multi))
when "ps" then run!(*compose("ps", multi: multi))
when "psql" then run!(*compose("exec", "postgres", "psql", "-U", "postgres", multi: multi))
when "console" then run!(*compose("exec", "masks", "bin/rails", "console", multi: multi))
when "image" then image(ARGV)
when "first-sign-in" then first_sign_in(ARGV)
when "test" then test(ARGV)
when "conformance" then conformance(ARGV) || exit(1)
when "reference" then reference
when "fmt" then fmt(ARGV)
else usage
end
