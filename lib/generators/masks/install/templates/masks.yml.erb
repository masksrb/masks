defaults: &defaults
  url: <%= @url || "<%%= ENV['MASKS_URL'] %%>" %>
  <% if @server%><%= "mode: server\n" %><% end %>
development:
  <<: *defaults

test:
  <<: *defaults

production:
  <<: *defaults
