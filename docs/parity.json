    {
      "name": "Signing in with the code flow and PKCE",
      "cells": {
        "rails": {
          "file": "test/engine/session_test.rb",
          "test": "starting sends the browser to authorize with pkce, state and nonce"
        },
        "client": {
          "file": "test/client/session_test.rb",
          "test": "test_the_authorization_url_carries_pkce_and_every_resource"
        },
        "web": {
          "file": "web/test/browser.test.js",
          "test": "a callback exchanges the code and returns where to go back to",
          "note": "Yes, through a backend or in the page"
        },
        "node": {
          "file": "node/test/signin.test.js",
          "test": "a sign-in goes through masks with PKCE, a nonce, and an organization"
        },
        "python": {
          "file": "python/tests/test_signin.py",
          "test": "test_start_builds_a_pkce_request"
        },
        "go": {
          "file": "go/signin_test.go",
          "test": "TestSigningInWithTheCodeFlow"
        }
      }
    },
    {
