<!DOCTYPE html>
<html class="h-full" data-theme="<%= content_for(:theme) || '' %>">
  <head>
    <title><%= content_for(:title) || "masks" %></title>

    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">

    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="<%= Masks.mode.favicon_url %>">
    <link rel="apple-touch-icon" href="<%= Masks.mode.favicon_url %>">

    <%= vite_client_tag %>
    <%= yield :styles %>
  </head>

  <body class="h-full <%= content_for(:body_class) || 'bg-base-300' %>">
    <%= yield %>
  </body>
</html>
