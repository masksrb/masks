<div class="flex flex-col gap-4">
  <h1 class="text-2xl font-bold">Login</h1>

  <%= form_with url: request.path, method: :post, class: "flex flex-col gap-4" do |f| %>
    <div class="form-control">
      <%= f.label :email, class: "label" %>
      <%= f.email_field :email, class: "input input-bordered w-full", required: true, autofocus: true %>
    </div>

    <div class="form-control">
      <%= f.label :password, class: "label" %>
      <%= f.password_field :password, class: "input input-bordered w-full", required: true %>
    </div>

    <div class="form-control mt-4">
      <%= f.submit "Sign in", class: "btn btn-primary w-full" %>
    </div>
  <% end %>
</div>
