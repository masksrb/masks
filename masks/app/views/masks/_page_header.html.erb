<% min_height = local_assigns.fetch(:min_height, '250px') %>
<div class="flex items-center justify-center my-6 grow <%= "min-h-[#{min_height}]" if min_height %>">
  <div class="flex flex-col text-center items-center px-5">
    <h1 class="text-black dark:text-white text-3xl font-bold mb-2 cols-3 justify-center">
      <% if local_assigns[:icon] %><span><%= icon %></span><% end %><span><%= title %></span>
    </h1>

    <h2 class="text-2xl opacity-75">
      <%= subtitle %>
    </h2>

    <% if content = yield rescue nil %><%= content %><% end %>
  </div>
</div>
