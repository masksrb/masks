<% if @captcha.enterprise? %>
  <script src="https://www.google.com/recaptcha/enterprise.js?render=explicit&onload=onRecaptchaLoadCallback" async defer></script>
<% else %>
  <script src="https://www.google.com/recaptcha/api.js?render=explicit&onload=onRecaptchaLoadCallback" async defer></script>
<% end %>

<%= render 'masks/page_header',
  icon: raw('<span class="loading loading-spinner loading-xs opacity-50"></span>'),
  title: 'Verifying your device',
  subtitle: 'Please wait a moment while we check for compatibility...' do %>
  <div class="flex items-center overflow-hidden pt-6">
    <div class="mx-auto" id="masks-recaptcha"></div>
  </div>
<% end %>

<script>
  function onRecaptchaLoadCallback() {
    masks.recaptcha({
      id: "masks-recaptcha",
      path: "<%= masks_captcha_verification_path(captcha: @captcha) %>",
      sitekey: '<%= @captcha.sitekey %>',
      variant: '<%= @captcha.variant %>',
    })
  }
</script>
