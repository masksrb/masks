#!/usr/bin/env bash
set -uo pipefail
cd "$(dirname "$0")/.." || exit 1

status=0

bundle exec rubocop -a || status=$?

for dir in server web; do
  (cd "$dir" && npx biome check --write) || status=$?
done

npx --yes prettier --write --no-error-on-unmatched-pattern \
  "*.{yml,yaml,md}" ".github/**/*.{yml,yaml}" \
  "server/config/**/*.{yml,yaml}" "conformance/**/*.{yml,yaml}" || status=$?

if command -v shfmt >/dev/null; then
  scripts=()
  while IFS= read -r script; do scripts+=("$script"); done < <(shfmt -f bin server/bin 2>/dev/null)
  [ ${#scripts[@]} -gt 0 ] && { shfmt -w -i 2 -ci "${scripts[@]}" || status=$?; }
fi

exit $status
