#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/../server"

[ -f .env ] || cp .env.example .env

if ! pg_dump --version 2>/dev/null | grep -qE '\b17\.' && ! grep -q '^PG_BIN_PATH=.' .env; then
  cat <<'TEXT' >&2
pg_dump 17 is not first on your PATH, and PG_BIN_PATH is not set in server/.env.

The schema is dumped as SQL, because schema.rb cannot represent the row-level
security policies that isolate tenants. That dump needs a pg_dump matching the
server, and an older one refuses outright.

  brew bundle
  echo "PG_BIN_PATH=$(brew --prefix postgresql@17)/bin" >> server/.env

Or skip the host toolchain entirely and work in containers: bin/test.

TEXT
  exit 1
fi

docker compose up -d --wait

bundle install
npm install
bin/rails db:prepare
bin/rails masks:tenants
bin/rails runner 'RefreshAuthenticatorsJob.perform_later'

cat <<'TEXT'

Tenants are addressed by subdomain. Either add these to /etc/hosts:

  127.0.0.1 auth.test demo.auth.test acme.auth.test

...or use *.auth.localhost, which resolves without any setup.

Then bin/dev, and http://demo.auth.localhost:5555
TEXT
