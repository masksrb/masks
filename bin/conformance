#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/../conformance"

export SUITE_REF="${SUITE_REF:-release-v5.2.4}"
export SUITE_PORT="${SUITE_PORT:-8443}"

SUITE_REPO="${SUITE_REPO:-https://gitlab.com/openid/conformance-suite.git}"
SUITE_DIR=".suite"
CONFIG="/conformance/masks.json"

PLANS=(
  "oidcc-config-certification-test-plan"
  "oidcc-basic-certification-test-plan[server_metadata=discovery][client_registration=dynamic_client]"
)

usage() {
  echo "usage: bin/conformance [up|run|logs|down|plans]" >&2
  exit 64
}

fetch_suite() {
  if [ ! -d "$SUITE_DIR/.git" ]; then
    git clone --depth 1 --branch "$SUITE_REF" "$SUITE_REPO" "$SUITE_DIR"
  else
    git -C "$SUITE_DIR" fetch --depth 1 origin "refs/tags/$SUITE_REF"
    git -C "$SUITE_DIR" checkout --detach FETCH_HEAD
  fi
}

up() {
  fetch_suite
  mkdir -p results
  docker compose up -d --wait masks proxy mongodb server nginx
  docker compose exec -T masks ./bin/rails runner - <owner.rb
}

run() {
  local args=()

  for plan in "${PLANS[@]}"; do
    args+=("'$plan'" "$CONFIG")
  done

  docker compose run --rm runner \
    "pip install --quiet -r /suite/scripts/requirements.txt && \
     exec python /suite/scripts/run-test-plan.py \
       --export-dir /results \
       --expected-failures-file /conformance/expected-failures.json \
       --expected-skips-file /conformance/expected-skips.json \
       --verbose \
       ${args[*]}" 2>&1 | tee results/run.log
}

case "${1:-run}" in
  up) up ;;
  run) up && run ;;
  logs) docker compose logs -f "${2:-server}" ;;
  down) docker compose down -v --remove-orphans ;;
  plans) printf '%s\n' "${PLANS[@]}" ;;
  *) usage ;;
esac
