#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."

(
  cd server
  BUNDLE_GEMFILE="$PWD/Gemfile" bin/rails docs:reference
)

(
  cd client
  export BUNDLE_GEMFILE="$PWD/Gemfile"
  bundle check >/dev/null 2>&1 || bundle install --quiet
  bundle exec rake reference:mdx
)

(
  cd docs
  [ -d node_modules ] || npm ci
  npm run reference
)
