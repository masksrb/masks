#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/../server"

PORT="${MASKS_IMAGE_PORT:-5556}"
SUFFIX="${MASKS_IMAGE_HOST_SUFFIX:-auth.localhost}"

case "${1:-up}" in
  down)
    docker compose --profile image down
    exit 0
    ;;
  logs)
    docker compose --profile image logs -f masks
    exit 0
    ;;
  build)
    docker compose --profile image build masks
    exit 0
    ;;
  up) ;;
  *)
    echo "usage: bin/image [up|build|logs|down]" >&2
    exit 64
    ;;
esac

docker compose --profile image up -d --build --wait

fetch() {
  curl -fsS --connect-to "$1.$SUFFIX:$PORT:127.0.0.1:$PORT" \
    "http://$1.$SUFFIX:$PORT$2"
}

kid_of() {
  fetch "$1" /.well-known/jwks.json |
    grep -o '"kid":"[^"]*"' | head -1 | cut -d'"' -f4
}

issuer_of() {
  fetch "$1" /.well-known/openid-configuration |
    grep -o '"issuer":"[^"]*"' | head -1 | cut -d'"' -f4
}

fail() { echo "FAIL: $1" >&2; exit 1; }

jons_issuer=$(issuer_of jons) || fail "jons discovery did not answer"
acme_issuer=$(issuer_of acme) || fail "acme discovery did not answer"

[ "$jons_issuer" = "http://jons.$SUFFIX:$PORT" ] ||
  fail "jons issuer is $jons_issuer"
[ "$acme_issuer" = "http://acme.$SUFFIX:$PORT" ] ||
  fail "acme issuer is $acme_issuer"

jons_kid=$(kid_of jons) || fail "jons published no JWKS"
acme_kid=$(kid_of acme) || fail "acme published no JWKS"

[ -n "$jons_kid" ] || fail "jons published an empty JWKS"
[ -n "$acme_kid" ] || fail "acme published an empty JWKS"
[ "$jons_kid" != "$acme_kid" ] ||
  fail "both tenants published kid $jons_kid — keys are not per-tenant"

status=$(curl -fsS -o /dev/null -w '%{http_code}' "http://127.0.0.1:$PORT/up")
[ "$status" = "200" ] || fail "/up answered $status"

cat <<TEXT

image ok — masks:dev is serving on port $PORT

  health    /up                                     $status
  jons      $jons_issuer   kid $jons_kid
  acme      $acme_issuer   kid $acme_kid

  bin/image logs      follow the container
  bin/image down      stop it
TEXT
