#!/usr/bin/env bash
set -uo pipefail
cd "$(dirname "$0")/.." || exit 1

ALL=(server client web)

usage() {
  cat <<'TEXT' >&2
usage: bin/test [suite...] | down

  server   the Rails app, against a postgres of its own
  client   masks, the Ruby gem — both halves, then a gem build
  web      @masks/client, the browser package

Every suite runs in a container, so this needs docker and nothing else. CI runs
these same three. With no arguments it runs all three, keeps going after a
failure, and reports at the end.

  bin/test              all three
  bin/test client web   only those
  bin/test down         stop everything and drop the cache volumes

Under CI, compose.test.ci.yml is layered on to read and write the build cache
the runner has and a laptop does not.
TEXT
  exit 64
}

files=(-f compose.test.yml)
[ -n "${CI:-}" ] && files+=(-f compose.test.ci.yml)

compose() { docker compose "${files[@]}" "$@"; }

case "${1:-}" in
  -h | --help) usage ;;
  down)
    compose down -v --remove-orphans
    exit 0
    ;;
esac

suites=("$@")
[ ${#suites[@]} -eq 0 ] && suites=("${ALL[@]}")

for suite in "${suites[@]}"; do
  case " ${ALL[*]} " in
    *" $suite "*) ;;
    *)
      echo "no such suite: $suite" >&2
      usage
      ;;
  esac
done

failed=()

for suite in "${suites[@]}"; do
  printf '\n\033[1m== %s ==\033[0m\n\n' "$suite"

  compose run --rm --build "$suite" || failed+=("$suite")
done

compose down --remove-orphans >/dev/null 2>&1

echo

if [ ${#failed[@]} -eq 0 ]; then
  printf '\033[32mpassed\033[0m: %s\n' "${suites[*]}"
  exit 0
fi

printf '\033[31mfailed\033[0m: %s\n' "${failed[*]}"
exit 1
