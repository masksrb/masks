{
  "name": "@masks/server",
  "version": "0.1.0",
  "description": "A masks client for servers: signing people in with the handshake and the code flow, sessions for Next.js, Auth.js, Express, and Hono, client credentials, the device flow, token exchange, DPoP, enrollment, introspection, and checking access tokens.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/masksrb/masks.git",
    "directory": "node"
  },
  "homepage": "https://github.com/masksrb/masks/tree/main/node#readme",
  "bugs": "https://github.com/masksrb/masks/issues",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./next": {
      "types": "./dist/next.d.ts",
      "default": "./dist/next.js"
    },
    "./express": {
      "types": "./dist/express.d.ts",
      "default": "./dist/express.js"
    },
    "./hono": {
      "types": "./dist/hono.d.ts",
      "default": "./dist/hono.js"
    },
    "./authjs": {
      "types": "./dist/authjs.d.ts",
      "default": "./dist/authjs.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "test": "node --import ./test/next-resolve.js --test test/*.test.js"
  },
  "dependencies": {
    "jose": "6.2.12"
  },
  "peerDependencies": {
    "express": ">=4.18",
    "hono": ">=4",
    "next": ">=15",
    "next-auth": ">=5.0.0-beta.30"
  },
  "peerDependenciesMeta": {
    "express": {
      "optional": true
    },
    "hono": {
      "optional": true
    },
    "next": {
      "optional": true
    },
    "next-auth": {
      "optional": true
    }
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@types/express": "5.0.6",
    "@types/node": "20.19.43",
    "express": "5.2.1",
    "hono": "4.13.9",
    "next": "16.3.8",
    "next-auth": "5.0.0-beta.32",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "^7.0.2"
  }
}
